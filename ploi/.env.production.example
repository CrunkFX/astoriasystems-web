# Environment der Ploi-Site www.astoria.systems (Site → Environment), liegt als .env im Site-Verzeichnis.
#
# Astro liest beim Build nur SITE_URL (PUBLIC_*-Werte landeten im HTML – hier gibt es keine). Alles andere
# bleibt auf dem Server: server/kontakt.php liest es bei jeder Kontaktanfrage. Werte hier eintragen, nie im
# Repository; `bash ploi/ploi.sh env-push` ersetzt die ganze .env.

# Kanonische Adresse (Canonical, hreflang, Open Graph, Sitemap), ohne Slash am Ende. Mit www: so heißt
# die Ploi-Site, und Ploi leitet den Apex astoria.systems beim Zertifikat-Einbau selbst hierher um
# (Alias der Site, Zertifikat für beide Namen). Kein eigener Host-Redirect in nginx nötig.
SITE_URL=https://www.astoria.systems

# Kontaktformular: POST /api/contact → server/kontakt.php → Lettermint (ploi/nginx/, PHP 8.5 der Site).
# Sending-API-Token des Lettermint-Projekts – geheim, gehört nur hierher. Ohne Token antwortet das Formular mit 500.
LETTERMINT_TOKEN=
# Optional: Route im Lettermint-Projekt (leer = Standard-Route des Projekts).
LETTERMINT_ROUTE_ID=
# Absender (die Domain muss im Lettermint-Projekt verifiziert sein) und Empfänger der Anfragen. Antworten
# auf eine Anfrage gehen direkt an die Adresse aus dem Formular (Reply-To).
MAIL_FROM="Astoria Website <noreply@astoria.systems>"
CONTACT_EMAIL=service@astoria.systems
