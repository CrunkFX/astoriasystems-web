---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ContactFormHandler from '../../components/interactive/ContactFormHandler.tsx';
import ParticleNetwork from '../../components/visuals/ParticleNetwork.astro';
import { t } from '../../i18n/utils';

const locale = 'en';
const labels = {
  name: t(locale, 'contact.form.name'),
  email: t(locale, 'contact.form.email'),
  phone: t(locale, 'contact.form.phone'),
  company: t(locale, 'contact.form.company'),
  subject: t(locale, 'contact.form.subject'),
  message: t(locale, 'contact.form.message'),
  submit: t(locale, 'contact.form.submit'),
  sending: t(locale, 'contact.form.sending'),
  success: t(locale, 'contact.form.success'),
  error: t(locale, 'contact.form.error'),
};
---

<BaseLayout
  title={t(locale, 'contact.pageTitle')}
  description={t(locale, 'contact.pageDescription')}
  locale={locale}
  keywords="contact, Astoria Systems, consulting, software solutions, Germany"
  jsonLdType="contact"
  breadcrumbs={[{ name: 'Home', url: '/en' }, { name: t(locale, 'contact.title'), url: '/en/contact' }]}
>
  <section class="relative pt-28 lg:pt-32 pb-20 lg:pb-28 overflow-hidden">
    <ParticleNetwork density="low" />
    <div class="absolute inset-0 bg-[var(--color-surface-primary)]/75 dark:bg-[var(--color-dark-bg)]/70"></div>
    <Container class="relative z-10">
      <Breadcrumbs locale={locale} items={[{ label: t(locale, 'contact.title'), href: '/en/contact' }]} />
      <div class="max-w-3xl" data-reveal>
        <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">Contact</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6" data-text-reveal>{t(locale, 'contact.pageTitle')}</h1>
        <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">{t(locale, 'contact.subtitle')}</p>
      </div>
    </Container>
  </section>

  <section class="py-12 md:py-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2" data-reveal>
          <GlassCard>
            <ContactFormHandler client:visible locale={locale} labels={labels} />
          </GlassCard>
        </div>
        <div data-reveal data-reveal-delay="2">
          <GlassCard class="h-fit">
            <h2 class="text-lg font-semibold mb-6">{t(locale, 'contact.info.title')}</h2>
            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-[var(--color-accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <div>
                  <p class="font-medium">Astoria Systems GmbH</p>
                  <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">{t(locale, 'contact.info.address')}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-[var(--color-accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <a href="tel:+492821398620" class="hover:text-[var(--color-accent)] transition-colors">{t(locale, 'contact.info.phone')}</a>
              </div>
              <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-[var(--color-accent)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <a href="mailto:service@astoria.systems" class="hover:text-[var(--color-accent)] transition-colors">{t(locale, 'contact.info.email')}</a>
              </div>
              <div class="pt-4 border-t border-[var(--color-border)] dark:border-[var(--color-dark-border)]">
                <p class="text-[var(--color-text-tertiary)] dark:text-[var(--color-dark-text-tertiary)]">{t(locale, 'contact.info.representative')}</p>
              </div>
            </div>
          </GlassCard>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
