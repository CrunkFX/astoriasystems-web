---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Button from '../../components/ui/Button.astro';
import CTA from '../../components/sections/CTA.astro';
import { t, tArray } from '../../i18n/utils';

const locale = 'en';

const tiers = [
  { key: 'starter', popular: false },
  { key: 'professional', popular: true },
  { key: 'enterprise', popular: false },
];
---

<BaseLayout
  title={t(locale, 'pricing.pageTitle')}
  description={t(locale, 'pricing.pageDescription')}
  locale={locale}
  keywords="pricing, plans, software solutions, ERP pricing, CRM costs"
  jsonLdType="pricing"
  breadcrumbs={[{ name: 'Home', url: '/en' }, { name: t(locale, 'pricing.title'), url: '/en/pricing' }]}
>
  <section class="relative pt-28 lg:pt-32 pb-20 lg:pb-28 overflow-hidden">
    <Container class="relative z-10">
      <Breadcrumbs locale={locale} items={[{ label: t(locale, 'pricing.title'), href: '/en/pricing' }]} />
      <div class="max-w-3xl text-center mx-auto" data-reveal>
        <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">Pricing</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6" data-text-reveal>{t(locale, 'pricing.title')}</h1>
        <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
          {t(locale, 'pricing.subtitle')}
        </p>
      </div>
    </Container>
  </section>

  <section class="py-12 md:py-16">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {tiers.map((tier, index) => (
          <div data-reveal data-reveal-delay={index + 1} class="relative">
            {tier.popular && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-[var(--color-accent)] text-white">
                  {t(locale, 'pricing.popular')}
                </span>
              </div>
            )}
            <GlassCard class:list={['h-full flex flex-col', tier.popular && 'ring-2 ring-[var(--color-accent)]']}>
              <div class="mb-6">
                <h2 class="text-xl font-bold mb-2">{t(locale, `pricing.${tier.key}.name`)}</h2>
                <p class="text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] mb-4">
                  {t(locale, `pricing.${tier.key}.description`)}
                </p>
                <div class="text-3xl font-bold gradient-text">
                  {t(locale, `pricing.${tier.key}.price`)}
                </div>
              </div>
              <ul class="space-y-3 mb-8 flex-1">
                {tArray(locale, `pricing.${tier.key}.features`).map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <svg class="h-5 w-5 text-[var(--color-accent)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <Button href="/en/contact" variant={tier.popular ? 'primary' : 'secondary'} class="w-full">
                {t(locale, 'pricing.contactUs')}
              </Button>
            </GlassCard>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <CTA locale={locale} />
</BaseLayout>
