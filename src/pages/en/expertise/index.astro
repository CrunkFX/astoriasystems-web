---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import Expertise from '../../../components/sections/Expertise.astro';
import CTA from '../../../components/sections/CTA.astro';
import { t } from '../../../i18n/utils';

const locale = 'en';
---

<BaseLayout
  title="Expertise & Specializations | Astoria Systems"
  description="Deep technical expertise: Proxmox support & rescue (LINSTOR, Ceph), industrial infrastructure & IT security, and hardware & IoT automation."
  locale={locale}
  keywords="Proxmox support, Proxmox rescue, Ceph, LINSTOR, OT security, industrial IT, IoT automation, hardware"
  breadcrumbs={[{ name: 'Home', url: '/en' }, { name: t(locale, 'nav.expertise'), url: '/en/expertise' }]}
>
  <Expertise locale={locale}>
    <Breadcrumbs slot="breadcrumb" locale={locale} items={[{ label: t(locale, 'nav.expertise'), href: '/en/expertise' }]} />
  </Expertise>
  <CTA locale={locale} />
</BaseLayout>
