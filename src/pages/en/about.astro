---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CTA from '../../components/sections/CTA.astro';
import { t } from '../../i18n/utils';

const locale = 'en';

const values = [
  { title: 'Innovation', description: 'Always seeking better solutions and new possibilities.', icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>` },
  { title: 'Reliability', description: '98%+ availability and consistent quality in everything we do.', icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>` },
  { title: 'Security', description: 'Data protection and IT security come first.', icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>` },
  { title: 'Partnership', description: 'Long-term relationships on equal footing with our clients.', icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>` },
];
---

<BaseLayout
  title={t(locale, 'about.pageTitle')}
  description={t(locale, 'about.pageDescription')}
  locale={locale}
  keywords="about us, Astoria Systems, team, Bad Kreuznach, software company"
  jsonLdType="about"
  breadcrumbs={[{ name: 'Home', url: '/en' }, { name: t(locale, 'nav.about'), url: '/en/about' }]}
>
  <!-- Hero -->
  <section class="relative pt-28 lg:pt-32 pb-24 lg:pb-32 overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-surface-primary)]/72 dark:bg-[var(--color-dark-bg)]/68"></div>
    <Container class="relative z-10">
      <Breadcrumbs locale={locale} items={[{ label: t(locale, 'nav.about'), href: '/en/about' }]} />
      <div class="max-w-4xl" data-reveal>
        <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
          About us
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6" data-text-reveal>{t(locale, 'about.subtitle')}</h1>
        <p class="text-xl text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] max-w-2xl leading-relaxed">
          {t(locale, 'about.description')}
        </p>
      </div>
    </Container>
  </section>

  <!-- Mission & Team with images -->
  <Section class="!py-20 lg:!py-28">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div data-reveal="left">
          <div class="rounded-2xl overflow-hidden bg-gradient-to-br from-slate-50 via-slate-100/80 to-slate-50 dark:from-[#080c18] dark:via-[#0c1020] dark:to-[#080c18] border border-[var(--color-border)]/30 dark:border-[var(--color-dark-border)]/30 flex items-center justify-center p-12" style="aspect-ratio: 4/3;">
            <svg viewBox="0 0 120 120" fill="none" class="w-full h-full max-w-[180px] max-h-[180px] text-[var(--color-accent-dark)] dark:text-[var(--color-accent)]">
              <polygon points="60,15 25,55 95,55" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" />
              <polygon points="40,55 60,30 80,55" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.04" />
              <line x1="60" y1="15" x2="30" y2="85" stroke="currentColor" stroke-width="0.75" opacity="0.2" />
              <line x1="60" y1="15" x2="90" y2="85" stroke="currentColor" stroke-width="0.75" opacity="0.2" />
              <line x1="25" y1="55" x2="95" y2="55" stroke="currentColor" stroke-width="0.75" opacity="0.2" />
              <circle cx="60" cy="15" r="3" fill="currentColor" opacity="0.6" />
              <circle cx="25" cy="55" r="2" fill="currentColor" opacity="0.4" />
              <circle cx="95" cy="55" r="2" fill="currentColor" opacity="0.4" />
              <circle cx="30" cy="85" r="2" fill="currentColor" opacity="0.3" />
              <circle cx="90" cy="85" r="2" fill="currentColor" opacity="0.3" />
              <circle cx="60" cy="95" r="1.5" fill="currentColor" opacity="0.25" />
              <line x1="30" y1="85" x2="90" y2="85" stroke="currentColor" stroke-width="0.75" opacity="0.15" />
              <line x1="30" y1="85" x2="60" y2="95" stroke="currentColor" stroke-width="0.5" opacity="0.1" />
              <line x1="90" y1="85" x2="60" y2="95" stroke="currentColor" stroke-width="0.5" opacity="0.1" />
            </svg>
          </div>
        </div>
        <div data-reveal="right">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">{t(locale, 'about.missionTitle')}</h2>
          <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed mb-8">
            {t(locale, 'about.missionText')}
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">{t(locale, 'about.teamTitle')}</h2>
          <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
            {t(locale, 'about.teamText')}
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Values -->
  <Section variant="alt" class="!py-20 lg:!py-28">
    <Container>
      <div class="text-center mb-16" data-reveal>
        <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
          Our Values
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold">{t(locale, 'about.valuesTitle')}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((value, index) => (
          <div data-reveal data-reveal-delay={index + 1}>
            <GlassCard class="h-full text-center">
              <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] mb-4">
                <Fragment set:html={value.icon} />
              </div>
              <h3 class="text-xl font-semibold mb-2">{value.title}</h3>
              <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
                {value.description}
              </p>
            </GlassCard>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <CTA locale={locale} />
</BaseLayout>
