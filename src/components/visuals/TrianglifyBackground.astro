---
// Trianglify-style low-poly tessellation background
// Like the logo's "S" — Delaunay mesh with brand gradient fills
// Animated: vertices gently drift over time
interface Props {
  class?: string;
  variant?: 'hero' | 'section' | 'full';
}

const { class: className = '', variant = 'section' } = Astro.props;
---

<div
  class:list={['trianglify-bg absolute inset-0 overflow-hidden', className]}
  aria-hidden="true"
  data-trianglify-variant={variant}
>
  <canvas class="trianglify-canvas w-full h-full"></canvas>
  {variant !== 'full' && (
    <Fragment>
      <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-[var(--color-surface-primary)] dark:from-[var(--color-dark-bg)] to-transparent pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[var(--color-surface-primary)] dark:from-[var(--color-dark-bg)] to-transparent pointer-events-none"></div>
    </Fragment>
  )}
</div>

<script is:inline>
(function() {
  var wrappers = document.querySelectorAll('.trianglify-bg');
  wrappers.forEach(function(wrapper) {
    var canvas = wrapper.querySelector('.trianglify-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var variant = wrapper.getAttribute('data-trianglify-variant') || 'section';
    var isDark = document.documentElement.classList.contains('dark');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getPalette() {
      isDark = document.documentElement.classList.contains('dark');
      if (variant === 'hero') {
        if (isDark) {
          return {
            colors: [
              [3,7,18],[4,10,24],[6,14,32],[8,20,42],
              [12,30,52],[16,42,62],[22,58,72],
              [28,75,85],[36,95,105],[44,120,130],
            ],
            lineColor: '255,255,255',
            lineAlpha: 0.06,
          };
        }
        return {
          colors: [
            [250,254,255],[246,252,254],[240,250,253],
            [234,248,252],[226,245,250],[218,242,248],
            [208,238,245],[198,234,242],[186,230,238],
            [174,225,234],
          ],
          lineColor: '255,255,255',
          lineAlpha: 0.5,
        };
      }
      // section/full variant — more saturated
      if (isDark) {
        return {
          colors: [
            [3,7,18],[5,12,28],[8,20,40],[12,40,55],
            [20,70,80],[30,110,120],[46,154,160],
            [30,180,185],[30,214,214],[50,225,215],
            [63,224,208],[0,229,255],
          ],
          lineColor: '255,255,255',
          lineAlpha: 0.08,
        };
      }
      return {
        colors: [
          [245,252,255],[235,248,252],[220,244,248],
          [200,238,242],[175,232,238],[150,225,232],
          [120,215,225],[90,200,215],[46,154,160],
          [30,214,214],[63,224,208],[0,229,255],
        ],
        lineColor: '255,255,255',
        lineAlpha: 0.5,
      };
    }

    var themeObs = new MutationObserver(function() { needsRegen = true; });
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function triangulate(points) {
      var n = points.length;
      if (n < 3) return [];
      var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (var i = 0; i < n; i++) {
        if (points[i][0] < minX) minX = points[i][0];
        if (points[i][1] < minY) minY = points[i][1];
        if (points[i][0] > maxX) maxX = points[i][0];
        if (points[i][1] > maxY) maxY = points[i][1];
      }
      var dx = maxX - minX, dy = maxY - minY;
      var dMax = Math.max(dx, dy);
      var midX = (minX + maxX) / 2, midY = (minY + maxY) / 2;
      points.push([midX - 20 * dMax, midY - dMax]);
      points.push([midX + 20 * dMax, midY - dMax]);
      points.push([midX, midY + 20 * dMax]);
      var triangles = [[n, n + 1, n + 2]];
      for (var i = 0; i < n; i++) {
        var edges = [], toRemove = [];
        for (var j = 0; j < triangles.length; j++) {
          var t = triangles[j];
          if (inCircumcircle(points[i], points[t[0]], points[t[1]], points[t[2]])) {
            toRemove.push(j);
            edges.push([t[0], t[1]]); edges.push([t[1], t[2]]); edges.push([t[2], t[0]]);
          }
        }
        for (var j = toRemove.length - 1; j >= 0; j--) triangles.splice(toRemove[j], 1);
        var uniqueEdges = [];
        for (var j = 0; j < edges.length; j++) {
          var dup = false;
          for (var k = 0; k < edges.length; k++) {
            if (j !== k && edges[j][0] === edges[k][1] && edges[j][1] === edges[k][0]) { dup = true; break; }
          }
          if (!dup) uniqueEdges.push(edges[j]);
        }
        for (var j = 0; j < uniqueEdges.length; j++) triangles.push([uniqueEdges[j][0], uniqueEdges[j][1], i]);
      }
      var result = [];
      for (var i = 0; i < triangles.length; i++) {
        if (triangles[i][0] < n && triangles[i][1] < n && triangles[i][2] < n) result.push(triangles[i]);
      }
      points.splice(n, 3);
      return result;
    }

    function inCircumcircle(p, a, b, c) {
      var ax = a[0]-p[0], ay = a[1]-p[1];
      var bx = b[0]-p[0], by = b[1]-p[1];
      var cx = c[0]-p[0], cy = c[1]-p[1];
      return (ax*ax+ay*ay)*(bx*cy-cx*by)-(bx*bx+by*by)*(ax*cy-cx*ay)+(cx*cx+cy*cy)*(ax*by-bx*ay)>0;
    }

    function lerpColor(a, b, t) {
      return [Math.round(a[0]+(b[0]-a[0])*t), Math.round(a[1]+(b[1]-a[1])*t), Math.round(a[2]+(b[2]-a[2])*t)];
    }

    function pickColor(arr, t) {
      t = Math.max(0, Math.min(1, t));
      var idx = t * (arr.length - 1);
      var lo = Math.floor(idx);
      return lerpColor(arr[lo], arr[Math.min(lo+1, arr.length-1)], idx - lo);
    }

    // State
    var basePoints = [];
    var tris = [];
    var triColors = [];
    var pointSeeds = []; // per-point animation seeds
    var w = 0, h = 0;
    var needsRegen = true;
    var running = true;
    var time = 0;
    var animDrift = variant === 'hero' ? 6 : 8;
    var animSpeed = 0.0004;

    var observer = new IntersectionObserver(function(entries) {
      running = entries[0].isIntersecting;
    }, { threshold: 0 });
    observer.observe(wrapper);

    function setupMesh() {
      w = canvas.offsetWidth;
      h = canvas.offsetHeight;
      if (w === 0 || h === 0) return;
      canvas.width = w * dpr;
      canvas.height = h * dpr;

      var palette = getPalette();
      var cellSize = variant === 'hero' ? 60 : 80;
      var jitter = cellSize * 0.75;

      basePoints = [];
      pointSeeds = [];
      var cols = Math.ceil(w / cellSize) + 2;
      var rows = Math.ceil(h / cellSize) + 2;
      for (var row = -1; row <= rows; row++) {
        for (var col = -1; col <= cols; col++) {
          basePoints.push([
            col * cellSize + (Math.random() - 0.5) * jitter,
            row * cellSize + (Math.random() - 0.5) * jitter,
          ]);
          pointSeeds.push([
            Math.random() * Math.PI * 2,
            Math.random() * Math.PI * 2,
            0.7 + Math.random() * 0.6,
          ]);
        }
      }

      // Triangulate using base positions
      var pts = [];
      for (var i = 0; i < basePoints.length; i++) pts.push([basePoints[i][0], basePoints[i][1]]);
      tris = triangulate(pts);

      // Pre-compute colors per triangle
      triColors = [];
      for (var i = 0; i < tris.length; i++) {
        var t = tris[i];
        var centX = (basePoints[t[0]][0]+basePoints[t[1]][0]+basePoints[t[2]][0]) / 3;
        var centY = (basePoints[t[0]][1]+basePoints[t[1]][1]+basePoints[t[2]][1]) / 3;
        var gradPos = (centX / w * 0.6 + centY / h * 0.4);
        var noise = (Math.random() - 0.5) * 0.15;
        var colorPos = Math.max(0, Math.min(1, gradPos + noise));
        triColors.push(pickColor(palette.colors, colorPos));
      }

      needsRegen = false;
    }

    function draw() {
      if (!running) { requestAnimationFrame(draw); return; }
      if (needsRegen) setupMesh();
      if (basePoints.length === 0) { requestAnimationFrame(draw); return; }

      time += animSpeed;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      var palette = getPalette();

      for (var i = 0; i < tris.length; i++) {
        var t = tris[i];
        var s0 = pointSeeds[t[0]], s1 = pointSeeds[t[1]], s2 = pointSeeds[t[2]];

        var x0 = basePoints[t[0]][0] + Math.sin(time * s0[2] + s0[0]) * animDrift;
        var y0 = basePoints[t[0]][1] + Math.cos(time * s0[2] + s0[1]) * animDrift;
        var x1 = basePoints[t[1]][0] + Math.sin(time * s1[2] + s1[0]) * animDrift;
        var y1 = basePoints[t[1]][1] + Math.cos(time * s1[2] + s1[1]) * animDrift;
        var x2 = basePoints[t[2]][0] + Math.sin(time * s2[2] + s2[0]) * animDrift;
        var y2 = basePoints[t[2]][1] + Math.cos(time * s2[2] + s2[1]) * animDrift;

        var c = triColors[i];
        ctx.beginPath();
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.closePath();
        ctx.fillStyle = 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')';
        ctx.fill();
        ctx.strokeStyle = 'rgba(' + palette.lineColor + ',' + palette.lineAlpha + ')';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      requestAnimationFrame(draw);
    }

    if (prefersReduced) {
      setupMesh();
      // Draw once, static
      var palette = getPalette();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      for (var i = 0; i < tris.length; i++) {
        var t = tris[i];
        var c = triColors[i];
        ctx.beginPath();
        ctx.moveTo(basePoints[t[0]][0], basePoints[t[0]][1]);
        ctx.lineTo(basePoints[t[1]][0], basePoints[t[1]][1]);
        ctx.lineTo(basePoints[t[2]][0], basePoints[t[2]][1]);
        ctx.closePath();
        ctx.fillStyle = 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')';
        ctx.fill();
        ctx.strokeStyle = 'rgba(' + palette.lineColor + ',' + palette.lineAlpha + ')';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }
    } else {
      setupMesh();
      requestAnimationFrame(draw);
    }

    var rt;
    window.addEventListener('resize', function() { clearTimeout(rt); rt = setTimeout(function() { needsRegen = true; }, 200); });
  });
})();
</script>
