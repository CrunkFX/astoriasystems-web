---
interface Props {
  class?: string;
  density?: 'low' | 'medium' | 'high';
}

const { class: className = '', density = 'high' } = Astro.props;
const densityMap = { low: 50, medium: 80, high: 120 };
const count = densityMap[density];
---

<div class:list={['particle-network-wrapper absolute inset-0', className]} aria-hidden="true" data-particle-count={count}>
  <canvas class="particle-canvas w-full h-full"></canvas>
  <!-- Static fallback for reduced motion -->
  <div class="particle-fallback absolute inset-0 hero-gradient grid-pattern hidden"></div>
</div>

<script is:inline>
(function() {
  var wrappers = document.querySelectorAll('.particle-network-wrapper');
  wrappers.forEach(function(wrapper) {
    var canvas = wrapper.querySelector('.particle-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      canvas.style.display = 'none';
      var fb = wrapper.querySelector('.particle-fallback');
      if (fb) fb.classList.remove('hidden');
      return;
    }

    var isDark = document.documentElement.classList.contains('dark');
    var count = parseInt(wrapper.getAttribute('data-particle-count') || '120');
    var mouseX = -9999, mouseY = -9999;
    var mouseRadius = 220;
    var running = true;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    // Theme colors
    function getColors() {
      isDark = document.documentElement.classList.contains('dark');
      return {
        spoke: isDark ? [6, 182, 212] : [6, 148, 163],
        ring: isDark ? [59, 130, 246] : [37, 99, 175],
        particle: isDark ? [6, 182, 212] : [8, 145, 178],
        particleAlt: isDark ? [59, 130, 246] : [37, 99, 235],
        mouseGlow: isDark ? [6, 182, 212] : [14, 116, 144],
      };
    }
    var colors = getColors();

    // Watch for theme changes
    var themeObserver = new MutationObserver(function() { colors = getColors(); });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function resize() {
      canvas.width = canvas.offsetWidth * dpr;
      canvas.height = canvas.offsetHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildWeb();
    }

    // --- Spiderweb geometry ---
    var NUM_SPOKES = 16;
    var NUM_RINGS = 7;
    var webNodes = []; // { x, y, homeX, homeY, spoke, ring }
    var webCenter = { x: 0, y: 0 };
    var floaters = []; // small free-floating particles

    function buildWeb() {
      var w = canvas.offsetWidth;
      var h = canvas.offsetHeight;
      webCenter.x = w * 0.5;
      webCenter.y = h * 0.5;
      var maxR = Math.min(w, h) * 0.45;

      webNodes = [];
      // Center node
      webNodes.push({ x: webCenter.x, y: webCenter.y, homeX: webCenter.x, homeY: webCenter.y, spoke: -1, ring: -1 });

      // Intersection nodes: each spoke x each ring
      for (var s = 0; s < NUM_SPOKES; s++) {
        var angle = (s / NUM_SPOKES) * Math.PI * 2 - Math.PI / 2;
        for (var r = 1; r <= NUM_RINGS; r++) {
          var radius = (r / NUM_RINGS) * maxR;
          // Add slight organic wobble so it doesn't look mechanical
          var wobble = 1 + (Math.sin(s * 3.7 + r * 2.1) * 0.08);
          var angleWobble = angle + Math.sin(s * 1.3 + r * 0.7) * 0.04;
          var nx = webCenter.x + Math.cos(angleWobble) * radius * wobble;
          var ny = webCenter.y + Math.sin(angleWobble) * radius * wobble;
          webNodes.push({ x: nx, y: ny, homeX: nx, homeY: ny, spoke: s, ring: r });
        }
      }

      // Floating particles in the web
      var floatCount = Math.min(count, Math.floor(w / 16));
      floaters = [];
      for (var i = 0; i < floatCount; i++) {
        floaters.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          r: Math.random() * 1.5 + 0.4,
          o: Math.random() * 0.25 + 0.08,
          alt: Math.random() > 0.5,
          pulse: Math.random() * Math.PI * 2,
        });
      }
    }

    resize();
    window.addEventListener('resize', resize);

    // Helper: get node at spoke s, ring r
    function getNode(s, r) {
      if (r === 0) return webNodes[0]; // center
      return webNodes[1 + s * NUM_RINGS + (r - 1)];
    }

    // Mouse tracking
    canvas.addEventListener('mousemove', function(e) {
      var rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });
    canvas.addEventListener('mouseleave', function() { mouseX = -9999; mouseY = -9999; });
    canvas.addEventListener('touchmove', function(e) {
      var rect = canvas.getBoundingClientRect();
      mouseX = e.touches[0].clientX - rect.left;
      mouseY = e.touches[0].clientY - rect.top;
    }, { passive: true });
    canvas.addEventListener('touchend', function() { mouseX = -9999; mouseY = -9999; });

    // Visibility observer
    var observer = new IntersectionObserver(function(entries) {
      running = entries[0].isIntersecting;
    }, { threshold: 0 });
    observer.observe(canvas);

    var time = 0;
    function draw() {
      if (!running) { requestAnimationFrame(draw); return; }
      time += 0.016;
      var cw = canvas.offsetWidth;
      var ch = canvas.offsetHeight;
      ctx.clearRect(0, 0, cw, ch);

      // --- Update web nodes: mouse interaction + ambient breathing ---
      for (var i = 0; i < webNodes.length; i++) {
        var n = webNodes[i];
        // Ambient breathing - subtle oscillation
        var breathX = Math.sin(time * 0.5 + i * 0.3) * 1.5;
        var breathY = Math.cos(time * 0.4 + i * 0.5) * 1.5;

        // Mouse deformation
        var dx = mouseX - n.homeX;
        var dy = mouseY - n.homeY;
        var dist = Math.sqrt(dx * dx + dy * dy);
        var pullX = 0, pullY = 0;
        if (dist < mouseRadius && dist > 0) {
          var force = (1 - dist / mouseRadius) * (1 - dist / mouseRadius);
          // Pull toward mouse (web stretches)
          pullX = dx * force * 0.35;
          pullY = dy * force * 0.35;
        }

        // Smooth spring: ease toward target
        var targetX = n.homeX + breathX + pullX;
        var targetY = n.homeY + breathY + pullY;
        n.x += (targetX - n.x) * 0.1;
        n.y += (targetY - n.y) * 0.1;
      }

      // --- Mouse glow ---
      if (mouseX > -999 && mouseY > -999) {
        var grd = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, mouseRadius);
        grd.addColorStop(0, 'rgba(' + colors.mouseGlow.join(',') + ', ' + (isDark ? 0.1 : 0.07) + ')');
        grd.addColorStop(1, 'rgba(' + colors.mouseGlow.join(',') + ', 0)');
        ctx.fillStyle = grd;
        ctx.fillRect(0, 0, cw, ch);
      }

      // --- Draw spiderweb structural lines ---

      // 1) Radial spokes (center to outermost ring)
      for (var s = 0; s < NUM_SPOKES; s++) {
        var center = getNode(s, 0);
        ctx.beginPath();
        ctx.moveTo(center.x, center.y);
        for (var r = 1; r <= NUM_RINGS; r++) {
          var node = getNode(s, r);
          ctx.lineTo(node.x, node.y);
        }
        // Extend spoke beyond outermost ring to edge
        var outerNode = getNode(s, NUM_RINGS);
        var angle = Math.atan2(outerNode.y - center.y, outerNode.x - center.x);
        var extend = Math.max(cw, ch) * 0.15;
        ctx.lineTo(outerNode.x + Math.cos(angle) * extend, outerNode.y + Math.sin(angle) * extend);

        var spokeAlpha = isDark ? 0.12 : 0.08;
        // Brighten spoke near mouse
        var spokeMouseDist = 9999;
        for (var r2 = 1; r2 <= NUM_RINGS; r2++) {
          var sn = getNode(s, r2);
          var sd = Math.sqrt((sn.x - mouseX) * (sn.x - mouseX) + (sn.y - mouseY) * (sn.y - mouseY));
          if (sd < spokeMouseDist) spokeMouseDist = sd;
        }
        if (spokeMouseDist < mouseRadius) {
          spokeAlpha += (1 - spokeMouseDist / mouseRadius) * (isDark ? 0.2 : 0.12);
        }

        ctx.strokeStyle = 'rgba(' + colors.spoke.join(',') + ', ' + spokeAlpha + ')';
        ctx.lineWidth = isDark ? 0.8 : 0.6;
        ctx.stroke();
      }

      // 2) Concentric rings (connecting nodes on same ring across spokes)
      for (var r = 1; r <= NUM_RINGS; r++) {
        ctx.beginPath();
        var firstNode = getNode(0, r);
        ctx.moveTo(firstNode.x, firstNode.y);
        for (var s = 1; s <= NUM_SPOKES; s++) {
          var nextNode = getNode(s % NUM_SPOKES, r);
          // Use quadratic curve for organic spiral feel
          var midS = s - 0.5;
          var prevNode = getNode((s - 1) % NUM_SPOKES, r);
          var cpx = (prevNode.x + nextNode.x) / 2 + (webCenter.x - (prevNode.x + nextNode.x) / 2) * 0.06;
          var cpy = (prevNode.y + nextNode.y) / 2 + (webCenter.y - (prevNode.y + nextNode.y) / 2) * 0.06;
          ctx.quadraticCurveTo(cpx, cpy, nextNode.x, nextNode.y);
        }

        var ringAlpha = isDark ? 0.09 : 0.06;
        // Outer rings fainter
        ringAlpha *= (1 - (r / NUM_RINGS) * 0.4);
        // Mouse brightening
        var ringR = Math.sqrt(
          Math.pow(firstNode.homeX - webCenter.x, 2) + Math.pow(firstNode.homeY - webCenter.y, 2)
        );
        var mouseFromCenter = Math.sqrt(
          Math.pow(mouseX - webCenter.x, 2) + Math.pow(mouseY - webCenter.y, 2)
        );
        if (Math.abs(mouseFromCenter - ringR) < mouseRadius * 0.5) {
          ringAlpha += (1 - Math.abs(mouseFromCenter - ringR) / (mouseRadius * 0.5)) * (isDark ? 0.12 : 0.08);
        }

        ctx.strokeStyle = 'rgba(' + colors.ring.join(',') + ', ' + ringAlpha + ')';
        ctx.lineWidth = r <= 2 ? (isDark ? 0.6 : 0.5) : (isDark ? 0.4 : 0.3);
        ctx.stroke();
      }

      // 3) Draw intersection nodes (small dots at spoke/ring crossings)
      for (var i = 0; i < webNodes.length; i++) {
        var n = webNodes[i];
        var nodeR = n.ring === -1 ? 3 : (n.ring <= 2 ? 2 : 1.2);
        var nodeAlpha = isDark ? 0.35 : 0.2;

        // Brighten nodes near mouse
        var ndx = n.x - mouseX;
        var ndy = n.y - mouseY;
        var nd = Math.sqrt(ndx * ndx + ndy * ndy);
        if (nd < mouseRadius) {
          var boost = (1 - nd / mouseRadius);
          nodeAlpha += boost * (isDark ? 0.4 : 0.25);
          nodeR += boost * 1.5;
        }

        // Glow halo for larger nodes
        if (nodeR > 1.5) {
          var glow = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, nodeR * 4);
          glow.addColorStop(0, 'rgba(' + colors.spoke.join(',') + ', ' + (nodeAlpha * 0.3) + ')');
          glow.addColorStop(1, 'rgba(' + colors.spoke.join(',') + ', 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(n.x, n.y, nodeR * 4, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, nodeR, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + colors.spoke.join(',') + ', ' + nodeAlpha + ')';
        ctx.fill();
      }

      // --- Draw floating particles ---
      for (var i = 0; i < floaters.length; i++) {
        var p = floaters[i];
        p.pulse += 0.02;
        p.x += p.vx;
        p.y += p.vy;

        // Mouse interaction: gentle swirl
        var fdx = mouseX - p.x;
        var fdy = mouseY - p.y;
        var fd = Math.sqrt(fdx * fdx + fdy * fdy);
        if (fd < mouseRadius && fd > 0) {
          var ff = (1 - fd / mouseRadius) * 0.03;
          p.vx += (-fdy / fd * ff + fdx / fd * 0.01);
          p.vy += (fdx / fd * ff + fdy / fd * 0.01);
        }

        p.vx *= 0.99;
        p.vy *= 0.99;

        // Wrap edges
        if (p.x < -10) p.x = cw + 10;
        if (p.x > cw + 10) p.x = -10;
        if (p.y < -10) p.y = ch + 10;
        if (p.y > ch + 10) p.y = -10;

        var pAlpha = p.o + Math.sin(p.pulse) * 0.1;
        var col = p.alt ? colors.particleAlt : colors.particle;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + col.join(',') + ', ' + pAlpha + ')';
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    requestAnimationFrame(draw);
  });
})();
</script>
