---
interface Props {
  type: 'communication' | 'security' | 'infrastructure' | 'development';
  class?: string;
}

const { type, class: className = '' } = Astro.props;

const colorConfig = {
  communication: { primary: '6,182,212', secondary: '59,130,246', accent: '34,211,238' },
  security: { primary: '34,197,94', secondary: '16,185,129', accent: '74,222,128' },
  infrastructure: { primary: '139,92,246', secondary: '168,85,247', accent: '196,181,253' },
  development: { primary: '249,115,22', secondary: '239,68,68', accent: '251,191,36' },
};
const c = colorConfig[type];
---

<div
  class:list={['service-hero-canvas-wrapper absolute inset-0', className]}
  aria-hidden="true"
  data-service-type={type}
  data-color-primary={c.primary}
  data-color-secondary={c.secondary}
  data-color-accent={c.accent}
>
  <canvas class="service-hero-canvas w-full h-full"></canvas>
</div>

<script is:inline>
(function() {
  var wrappers = document.querySelectorAll('.service-hero-canvas-wrapper');
  wrappers.forEach(function(wrapper) {
    var canvas = wrapper.querySelector('.service-hero-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      canvas.style.display = 'none';
      return;
    }

    var type = wrapper.getAttribute('data-service-type');
    var primary = wrapper.getAttribute('data-color-primary').split(',').map(Number);
    var secondary = wrapper.getAttribute('data-color-secondary').split(',').map(Number);
    var accent = wrapper.getAttribute('data-color-accent').split(',').map(Number);
    var isDark = document.documentElement.classList.contains('dark');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var mouseX = -9999, mouseY = -9999;
    var mouseRadius = 200;
    var running = true;
    var time = 0;
    var cw, ch;

    var themeObs = new MutationObserver(function() {
      isDark = document.documentElement.classList.contains('dark');
    });
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function resize() {
      cw = canvas.offsetWidth;
      ch = canvas.offsetHeight;
      canvas.width = cw * dpr;
      canvas.height = ch * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      init();
    }

    canvas.addEventListener('mousemove', function(e) {
      var r = canvas.getBoundingClientRect();
      mouseX = e.clientX - r.left;
      mouseY = e.clientY - r.top;
    });
    canvas.addEventListener('mouseleave', function() { mouseX = -9999; mouseY = -9999; });
    canvas.addEventListener('touchmove', function(e) {
      var r = canvas.getBoundingClientRect();
      mouseX = e.touches[0].clientX - r.left;
      mouseY = e.touches[0].clientY - r.top;
    }, { passive: true });
    canvas.addEventListener('touchend', function() { mouseX = -9999; mouseY = -9999; });

    var visObs = new IntersectionObserver(function(entries) {
      running = entries[0].isIntersecting;
    }, { threshold: 0 });
    visObs.observe(canvas);

    // rgba helper
    function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')'; }

    // Shared elements
    var nodes = [];
    var floaters = [];
    var shapes = [];

    function init() {
      nodes = [];
      floaters = [];
      shapes = [];

      if (type === 'communication') initCommunication();
      else if (type === 'security') initSecurity();
      else if (type === 'infrastructure') initInfrastructure();
      else if (type === 'development') initDevelopment();
    }

    // ==========================================
    // COMMUNICATION: Chat bubbles & connection lines
    // ==========================================
    function initCommunication() {
      // Floating connected nodes (representing people/channels)
      var count = Math.floor(cw * ch / 18000);
      count = Math.max(20, Math.min(count, 60));
      for (var i = 0; i < count; i++) {
        nodes.push({
          x: Math.random() * cw,
          y: Math.random() * ch,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          r: Math.random() * 2 + 1.5,
          type: Math.random() > 0.6 ? 'bubble' : 'dot',
          phase: Math.random() * Math.PI * 2,
          size: Math.random() * 16 + 12,
        });
      }
    }

    function drawCommunication() {
      var connectDist = 150;
      var baseAlpha = isDark ? 0.15 : 0.08;

      // Mouse glow
      drawMouseGlow();

      // Connection lines
      for (var i = 0; i < nodes.length; i++) {
        for (var j = i + 1; j < nodes.length; j++) {
          var dx = nodes[i].x - nodes[j].x;
          var dy = nodes[i].y - nodes[j].y;
          var d = Math.sqrt(dx * dx + dy * dy);
          if (d < connectDist) {
            var alpha = (1 - d / connectDist) * baseAlpha;
            // Brighten near mouse
            var mx = (nodes[i].x + nodes[j].x) / 2;
            var my = (nodes[i].y + nodes[j].y) / 2;
            var md = Math.sqrt((mx - mouseX) * (mx - mouseX) + (my - mouseY) * (my - mouseY));
            if (md < mouseRadius) alpha += (1 - md / mouseRadius) * 0.15;

            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.strokeStyle = rgba(primary, alpha);
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      // Nodes & chat bubbles
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        updateNode(n);

        var nd = Math.sqrt((n.x - mouseX) * (n.x - mouseX) + (n.y - mouseY) * (n.y - mouseY));
        var mouseBoost = nd < mouseRadius ? (1 - nd / mouseRadius) : 0;

        if (n.type === 'bubble') {
          // Chat bubble shape
          var bSize = n.size + mouseBoost * 6;
          var bAlpha = (isDark ? 0.06 : 0.03) + mouseBoost * 0.08;
          var bobY = Math.sin(time * 0.8 + n.phase) * 3;

          ctx.save();
          ctx.translate(n.x, n.y + bobY);
          ctx.beginPath();
          // Rounded rect bubble
          var bw = bSize * 1.4, bh = bSize;
          var br = bSize * 0.3;
          ctx.moveTo(-bw/2 + br, -bh/2);
          ctx.lineTo(bw/2 - br, -bh/2);
          ctx.quadraticCurveTo(bw/2, -bh/2, bw/2, -bh/2 + br);
          ctx.lineTo(bw/2, bh/2 - br);
          ctx.quadraticCurveTo(bw/2, bh/2, bw/2 - br, bh/2);
          // Tail
          ctx.lineTo(-bw/4, bh/2);
          ctx.lineTo(-bw/3, bh/2 + bSize * 0.25);
          ctx.lineTo(-bw/2 + br, bh/2);
          ctx.quadraticCurveTo(-bw/2, bh/2, -bw/2, bh/2 - br);
          ctx.lineTo(-bw/2, -bh/2 + br);
          ctx.quadraticCurveTo(-bw/2, -bh/2, -bw/2 + br, -bh/2);
          ctx.closePath();
          ctx.fillStyle = rgba(primary, bAlpha);
          ctx.strokeStyle = rgba(primary, bAlpha + 0.05);
          ctx.lineWidth = 0.5;
          ctx.fill();
          ctx.stroke();

          // Lines inside bubble
          if (bSize > 14) {
            var lineAlpha = bAlpha * 0.8;
            for (var l = 0; l < 3; l++) {
              var ly = -bh/2 + bh * 0.3 + l * (bh * 0.2);
              var lw = bw * (l === 2 ? 0.4 : 0.65);
              ctx.beginPath();
              ctx.moveTo(-lw/2, ly);
              ctx.lineTo(lw/2, ly);
              ctx.strokeStyle = rgba(accent, lineAlpha);
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
          ctx.restore();
        } else {
          // Regular dot node
          var dotR = n.r + mouseBoost * 2;
          var dotAlpha = (isDark ? 0.3 : 0.15) + mouseBoost * 0.3;

          // Glow
          if (dotR > 2) {
            var g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, dotR * 4);
            g.addColorStop(0, rgba(primary, dotAlpha * 0.3));
            g.addColorStop(1, rgba(primary, 0));
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(n.x, n.y, dotR * 4, 0, Math.PI * 2);
            ctx.fill();
          }

          ctx.beginPath();
          ctx.arc(n.x, n.y, dotR, 0, Math.PI * 2);
          ctx.fillStyle = rgba(Math.random() > 0.5 ? primary : secondary, dotAlpha);
          ctx.fill();
        }
      }
    }

    // ==========================================
    // SECURITY: Hexagonal grid with shield nodes
    // ==========================================
    function initSecurity() {
      // Hexagonal grid
      var hexSize = 50;
      var hexH = hexSize * Math.sqrt(3);
      var cols = Math.ceil(cw / (hexSize * 1.5)) + 2;
      var rows = Math.ceil(ch / hexH) + 2;

      for (var r = -1; r < rows; r++) {
        for (var c = -1; c < cols; c++) {
          var x = c * hexSize * 1.5;
          var y = r * hexH + (c % 2 === 0 ? 0 : hexH / 2);
          nodes.push({
            x: x, y: y,
            homeX: x, homeY: y,
            isShield: Math.random() > 0.85,
            phase: Math.random() * Math.PI * 2,
            pulse: 0,
          });
        }
      }

      // Floating lock particles
      var lockCount = Math.floor(cw * ch / 40000);
      for (var i = 0; i < Math.max(5, lockCount); i++) {
        floaters.push({
          x: Math.random() * cw, y: Math.random() * ch,
          vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2,
          size: Math.random() * 10 + 8,
          phase: Math.random() * Math.PI * 2,
          type: Math.random() > 0.5 ? 'lock' : 'shield',
        });
      }
    }

    function drawSecurity() {
      var hexSize = 50;
      var baseAlpha = isDark ? 0.07 : 0.04;

      drawMouseGlow();

      // Draw hex grid
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        // Breathe
        var bx = Math.sin(time * 0.3 + n.phase) * 1;
        var by = Math.cos(time * 0.25 + n.phase * 1.3) * 1;

        // Mouse interaction
        var dx = mouseX - n.homeX;
        var dy = mouseY - n.homeY;
        var d = Math.sqrt(dx * dx + dy * dy);
        var push = 0;
        if (d < mouseRadius && d > 0) {
          push = (1 - d / mouseRadius);
        }

        n.x += (n.homeX + bx + dx * push * 0.15 - n.x) * 0.08;
        n.y += (n.homeY + by + dy * push * 0.15 - n.y) * 0.08;

        var alpha = baseAlpha + push * (isDark ? 0.15 : 0.1);

        // Draw hexagon
        ctx.beginPath();
        for (var a = 0; a < 6; a++) {
          var angle = (Math.PI / 3) * a - Math.PI / 6;
          var hx = n.x + hexSize * 0.4 * Math.cos(angle);
          var hy = n.y + hexSize * 0.4 * Math.sin(angle);
          if (a === 0) ctx.moveTo(hx, hy);
          else ctx.lineTo(hx, hy);
        }
        ctx.closePath();
        ctx.strokeStyle = rgba(primary, alpha);
        ctx.lineWidth = 0.5;
        ctx.stroke();

        if (push > 0.3) {
          ctx.fillStyle = rgba(primary, alpha * 0.3);
          ctx.fill();
        }

        // Shield icon at special nodes
        if (n.isShield && d < mouseRadius * 1.5) {
          var shieldAlpha = (isDark ? 0.15 : 0.08) + push * 0.2;
          drawShieldIcon(n.x, n.y, 8 + push * 4, rgba(accent, shieldAlpha));
        }
      }

      // Floating lock/shield particles
      for (var i = 0; i < floaters.length; i++) {
        var f = floaters[i];
        f.x += f.vx;
        f.y += f.vy;
        f.phase += 0.01;
        if (f.x < -20) f.x = cw + 20;
        if (f.x > cw + 20) f.x = -20;
        if (f.y < -20) f.y = ch + 20;
        if (f.y > ch + 20) f.y = -20;

        var fd = Math.sqrt((f.x - mouseX) * (f.x - mouseX) + (f.y - mouseY) * (f.y - mouseY));
        var fb = fd < mouseRadius ? (1 - fd / mouseRadius) : 0;

        // Mouse repel
        if (fd < mouseRadius && fd > 0) {
          f.vx -= (mouseX - f.x) / fd * 0.05 * fb;
          f.vy -= (mouseY - f.y) / fd * 0.05 * fb;
        }
        f.vx *= 0.99; f.vy *= 0.99;

        var fAlpha = (isDark ? 0.1 : 0.05) + fb * 0.15 + Math.sin(f.phase) * 0.03;
        var fSize = f.size + fb * 4;

        if (f.type === 'lock') {
          drawLockIcon(f.x, f.y + Math.sin(time + f.phase) * 3, fSize, rgba(primary, fAlpha));
        } else {
          drawShieldIcon(f.x, f.y + Math.sin(time + f.phase) * 3, fSize, rgba(secondary, fAlpha));
        }
      }
    }

    function drawShieldIcon(x, y, s, color) {
      ctx.save();
      ctx.translate(x, y);
      ctx.beginPath();
      ctx.moveTo(0, -s);
      ctx.lineTo(s * 0.8, -s * 0.5);
      ctx.lineTo(s * 0.8, s * 0.2);
      ctx.quadraticCurveTo(s * 0.6, s * 0.8, 0, s);
      ctx.quadraticCurveTo(-s * 0.6, s * 0.8, -s * 0.8, s * 0.2);
      ctx.lineTo(-s * 0.8, -s * 0.5);
      ctx.closePath();
      ctx.strokeStyle = color;
      ctx.lineWidth = 1;
      ctx.stroke();
      // Checkmark inside
      ctx.beginPath();
      ctx.moveTo(-s * 0.25, 0);
      ctx.lineTo(-s * 0.05, s * 0.25);
      ctx.lineTo(s * 0.3, -s * 0.2);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.restore();
    }

    function drawLockIcon(x, y, s, color) {
      ctx.save();
      ctx.translate(x, y);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1;
      // Lock body
      ctx.strokeRect(-s * 0.35, -s * 0.05, s * 0.7, s * 0.55);
      // Shackle
      ctx.beginPath();
      ctx.arc(0, -s * 0.1, s * 0.25, Math.PI, 0);
      ctx.stroke();
      // Keyhole
      ctx.beginPath();
      ctx.arc(0, s * 0.2, s * 0.08, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }

    // ==========================================
    // INFRASTRUCTURE: Circuit board traces
    // ==========================================
    function initInfrastructure() {
      // Grid-based circuit nodes
      var spacing = 60;
      var cols = Math.ceil(cw / spacing) + 1;
      var rows = Math.ceil(ch / spacing) + 1;
      var idx = 0;
      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var x = c * spacing;
          var y = r * spacing;
          // Only some nodes are active
          if (Math.random() > 0.4) {
            nodes.push({
              x: x, y: y, homeX: x, homeY: y,
              active: Math.random() > 0.7,
              col: c, row: r,
              phase: Math.random() * Math.PI * 2,
              connections: [],
            });
          }
          idx++;
        }
      }

      // Create circuit-like connections (right, down, diagonal)
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        for (var j = i + 1; j < nodes.length; j++) {
          var m = nodes[j];
          var dx = Math.abs(n.homeX - m.homeX);
          var dy = Math.abs(n.homeY - m.homeY);
          // Only connect to nearby grid neighbors
          if ((dx <= spacing && dy === 0) || (dy <= spacing && dx === 0)) {
            if (Math.random() > 0.3) {
              n.connections.push(j);
            }
          }
        }
      }

      // Data packets flowing along traces
      for (var i = 0; i < 15; i++) {
        floaters.push({
          traceStart: Math.floor(Math.random() * nodes.length),
          traceEnd: -1,
          progress: 0,
          speed: Math.random() * 0.015 + 0.005,
          x: 0, y: 0,
        });
        pickNewTrace(floaters[floaters.length - 1]);
      }
    }

    function pickNewTrace(f) {
      var n = nodes[f.traceStart];
      if (n && n.connections.length > 0) {
        f.traceEnd = n.connections[Math.floor(Math.random() * n.connections.length)];
      } else {
        f.traceStart = Math.floor(Math.random() * nodes.length);
        f.traceEnd = f.traceStart;
      }
      f.progress = 0;
    }

    function drawInfrastructure() {
      var baseAlpha = isDark ? 0.08 : 0.04;

      drawMouseGlow();

      // Update nodes
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var bx = Math.sin(time * 0.4 + n.phase) * 0.5;
        var by = Math.cos(time * 0.35 + n.phase * 1.2) * 0.5;

        var dx = mouseX - n.homeX;
        var dy = mouseY - n.homeY;
        var d = Math.sqrt(dx * dx + dy * dy);
        var push = d < mouseRadius ? (1 - d / mouseRadius) : 0;

        n.x += (n.homeX + bx + dx * push * 0.1 - n.x) * 0.08;
        n.y += (n.homeY + by + dy * push * 0.1 - n.y) * 0.08;
      }

      // Draw traces (circuit lines) - right-angle style
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        for (var c = 0; c < n.connections.length; c++) {
          var m = nodes[n.connections[c]];
          if (!m) continue;

          var mx = (n.x + m.x) / 2;
          var my = (n.y + m.y) / 2;
          var md = Math.sqrt((mx - mouseX) * (mx - mouseX) + (my - mouseY) * (my - mouseY));
          var alpha = baseAlpha + (md < mouseRadius ? (1 - md / mouseRadius) * 0.12 : 0);

          ctx.beginPath();
          // L-shaped traces for circuit feel
          if (Math.abs(n.x - m.x) > 1 && Math.abs(n.y - m.y) > 1) {
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(m.x, n.y); // horizontal then vertical
            ctx.lineTo(m.x, m.y);
          } else {
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(m.x, m.y);
          }
          ctx.strokeStyle = rgba(primary, alpha);
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }

      // Draw nodes
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var nd = Math.sqrt((n.x - mouseX) * (n.x - mouseX) + (n.y - mouseY) * (n.y - mouseY));
        var nb = nd < mouseRadius ? (1 - nd / mouseRadius) : 0;
        var nodeAlpha = (isDark ? 0.2 : 0.1) + nb * 0.4;
        var nodeR = (n.active ? 3 : 1.5) + nb * 2;

        if (n.active || nb > 0.3) {
          // Square node (circuit style)
          ctx.save();
          ctx.translate(n.x, n.y);
          ctx.rotate(Math.PI / 4);
          ctx.fillStyle = rgba(n.active ? accent : primary, nodeAlpha);
          ctx.fillRect(-nodeR, -nodeR, nodeR * 2, nodeR * 2);
          ctx.restore();

          // Glow
          if (nb > 0.2) {
            var g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, nodeR * 5);
            g.addColorStop(0, rgba(primary, nodeAlpha * 0.3));
            g.addColorStop(1, rgba(primary, 0));
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(n.x, n.y, nodeR * 5, 0, Math.PI * 2);
            ctx.fill();
          }
        } else {
          ctx.beginPath();
          ctx.arc(n.x, n.y, nodeR, 0, Math.PI * 2);
          ctx.fillStyle = rgba(primary, nodeAlpha);
          ctx.fill();
        }
      }

      // Data packets
      for (var i = 0; i < floaters.length; i++) {
        var f = floaters[i];
        f.progress += f.speed;
        if (f.progress >= 1) {
          f.traceStart = f.traceEnd;
          pickNewTrace(f);
        }
        var start = nodes[f.traceStart];
        var end = nodes[f.traceEnd];
        if (!start || !end) continue;

        f.x = start.x + (end.x - start.x) * f.progress;
        f.y = start.y + (end.y - start.y) * f.progress;

        var pAlpha = isDark ? 0.5 : 0.3;
        // Glow trail
        var g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, 8);
        g.addColorStop(0, rgba(accent, pAlpha));
        g.addColorStop(1, rgba(accent, 0));
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, 8, 0, Math.PI * 2);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(f.x, f.y, 2, 0, Math.PI * 2);
        ctx.fillStyle = rgba(accent, pAlpha + 0.2);
        ctx.fill();
      }
    }

    // ==========================================
    // DEVELOPMENT: Code brackets & binary streams
    // ==========================================
    function initDevelopment() {
      // Floating code symbols
      var symbols = ['</', '/>', '{', '}', '()', '=>', '[]', '01', '&&', '||', '::'];
      var count = Math.floor(cw * ch / 25000);
      count = Math.max(12, Math.min(count, 35));

      for (var i = 0; i < count; i++) {
        nodes.push({
          x: Math.random() * cw,
          y: Math.random() * ch,
          vx: (Math.random() - 0.5) * 0.3,
          vy: -Math.random() * 0.3 - 0.1, // float upward
          symbol: symbols[Math.floor(Math.random() * symbols.length)],
          size: Math.random() * 10 + 10,
          phase: Math.random() * Math.PI * 2,
          rotation: (Math.random() - 0.5) * 0.3,
        });
      }

      // Connected node tree (representing code structure)
      var treeCount = Math.floor(cw * ch / 30000);
      treeCount = Math.max(8, Math.min(treeCount, 25));
      for (var i = 0; i < treeCount; i++) {
        floaters.push({
          x: Math.random() * cw,
          y: Math.random() * ch,
          homeX: Math.random() * cw,
          homeY: Math.random() * ch,
          r: Math.random() * 2 + 1,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    function drawDevelopment() {
      drawMouseGlow();

      var baseAlpha = isDark ? 0.12 : 0.06;

      // Draw tree connections
      var connectDist = 180;
      for (var i = 0; i < floaters.length; i++) {
        var n = floaters[i];
        var bx = Math.sin(time * 0.5 + n.phase) * 3;
        var by = Math.cos(time * 0.4 + n.phase * 1.2) * 3;
        var dx = mouseX - n.homeX;
        var dy = mouseY - n.homeY;
        var d = Math.sqrt(dx * dx + dy * dy);
        var push = d < mouseRadius ? (1 - d / mouseRadius) * 0.2 : 0;
        n.x += (n.homeX + bx + dx * push - n.x) * 0.06;
        n.y += (n.homeY + by + dy * push - n.y) * 0.06;

        for (var j = i + 1; j < floaters.length; j++) {
          var m = floaters[j];
          var cdx = n.x - m.x;
          var cdy = n.y - m.y;
          var cd = Math.sqrt(cdx * cdx + cdy * cdy);
          if (cd < connectDist) {
            var alpha = (1 - cd / connectDist) * baseAlpha;
            var mx2 = (n.x + m.x) / 2;
            var my2 = (n.y + m.y) / 2;
            var md2 = Math.sqrt((mx2 - mouseX) * (mx2 - mouseX) + (my2 - mouseY) * (my2 - mouseY));
            if (md2 < mouseRadius) alpha += (1 - md2 / mouseRadius) * 0.1;

            ctx.beginPath();
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(m.x, m.y);
            ctx.strokeStyle = rgba(secondary, alpha);
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }

        // Draw node
        var nd2 = Math.sqrt((n.x - mouseX) * (n.x - mouseX) + (n.y - mouseY) * (n.y - mouseY));
        var nb2 = nd2 < mouseRadius ? (1 - nd2 / mouseRadius) : 0;
        var dotR = n.r + nb2 * 2;
        var dotA = (isDark ? 0.25 : 0.12) + nb2 * 0.3;

        ctx.beginPath();
        ctx.arc(n.x, n.y, dotR, 0, Math.PI * 2);
        ctx.fillStyle = rgba(secondary, dotA);
        ctx.fill();
      }

      // Draw floating code symbols
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        n.phase += 0.008;
        n.x += n.vx + Math.sin(n.phase) * 0.2;
        n.y += n.vy;

        // Mouse interaction
        var fdx = mouseX - n.x;
        var fdy = mouseY - n.y;
        var fd = Math.sqrt(fdx * fdx + fdy * fdy);
        if (fd < mouseRadius && fd > 0) {
          // Repel from mouse
          n.vx -= fdx / fd * 0.03 * (1 - fd / mouseRadius);
          n.vy -= fdy / fd * 0.03 * (1 - fd / mouseRadius);
        }
        n.vx *= 0.995;
        n.vy *= 0.995;
        // Reset upward drift
        if (n.vy > -0.05) n.vy -= 0.002;

        // Wrap
        if (n.y < -30) { n.y = ch + 30; n.x = Math.random() * cw; }
        if (n.x < -30) n.x = cw + 30;
        if (n.x > cw + 30) n.x = -30;

        var symAlpha = (isDark ? 0.12 : 0.06) + (fd < mouseRadius ? (1 - fd / mouseRadius) * 0.15 : 0);
        var sway = Math.sin(time * 0.6 + n.phase) * 2;

        ctx.save();
        ctx.translate(n.x, n.y + sway);
        ctx.rotate(n.rotation * Math.sin(time * 0.3 + n.phase));
        ctx.font = n.size + 'px monospace';
        ctx.fillStyle = rgba(primary, symAlpha);
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(n.symbol, 0, 0);
        ctx.restore();
      }
    }

    // ==========================================
    // SHARED HELPERS
    // ==========================================
    function drawMouseGlow() {
      if (mouseX < -999) return;
      var g = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, mouseRadius);
      g.addColorStop(0, rgba(primary, isDark ? 0.08 : 0.05));
      g.addColorStop(0.5, rgba(secondary, isDark ? 0.03 : 0.02));
      g.addColorStop(1, rgba(primary, 0));
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, cw, ch);
    }

    function updateNode(n) {
      n.x += n.vx;
      n.y += n.vy;

      // Mouse interaction: gentle pull
      var dx = mouseX - n.x;
      var dy = mouseY - n.y;
      var d = Math.sqrt(dx * dx + dy * dy);
      if (d < mouseRadius && d > 0) {
        var f = (1 - d / mouseRadius) * 0.02;
        n.vx += dx / d * f;
        n.vy += dy / d * f;
      }

      n.vx *= 0.99;
      n.vy *= 0.99;

      // Wrap
      if (n.x < -20) n.x = cw + 20;
      if (n.x > cw + 20) n.x = -20;
      if (n.y < -20) n.y = ch + 20;
      if (n.y > ch + 20) n.y = -20;
    }

    // ==========================================
    // MAIN LOOP
    // ==========================================
    function draw() {
      if (!running) { requestAnimationFrame(draw); return; }
      time += 0.016;
      ctx.clearRect(0, 0, cw, ch);

      if (type === 'communication') drawCommunication();
      else if (type === 'security') drawSecurity();
      else if (type === 'infrastructure') drawInfrastructure();
      else if (type === 'development') drawDevelopment();

      requestAnimationFrame(draw);
    }

    resize();
    window.addEventListener('resize', resize);
    requestAnimationFrame(draw);
  });
})();
</script>
