---
// Global animated background - renders behind all page content
// Multi-layer system: aurora blobs, grid, particles, noise, geometric shapes
---

<div class="animated-bg fixed inset-0 -z-10 pointer-events-none" aria-hidden="true">
  <!-- Layer 1: Aurora gradient blobs -->
  <div class="aurora-layer absolute inset-0 overflow-hidden">
    <div class="aurora-blob aurora-blob-1"></div>
    <div class="aurora-blob aurora-blob-2"></div>
    <div class="aurora-blob aurora-blob-3"></div>
    <div class="aurora-blob aurora-blob-4"></div>
    <div class="aurora-blob aurora-blob-5"></div>
  </div>

  <!-- Layer 2: Animated grid with glowing intersections -->
  <div class="animated-bg-grid absolute inset-0"></div>

  <!-- Layer 3: Floating particles (CSS dots) -->
  <div class="animated-bg-dots absolute inset-0"></div>

  <!-- Layer 4: Moving gradient mesh -->
  <div class="animated-bg-gradients absolute inset-0"></div>

  <!-- Layer 5: Floating geometric shapes -->
  <div class="geo-layer absolute inset-0 overflow-hidden">
    <div class="geo-shape geo-hex geo-1"></div>
    <div class="geo-shape geo-ring geo-2"></div>
    <div class="geo-shape geo-tri geo-3"></div>
    <div class="geo-shape geo-hex geo-4"></div>
    <div class="geo-shape geo-ring geo-5"></div>
    <div class="geo-shape geo-diamond geo-6"></div>
    <div class="geo-shape geo-hex geo-7"></div>
    <div class="geo-shape geo-ring geo-8"></div>
  </div>

  <!-- Layer 6: Scan lines -->
  <div class="scan-line absolute inset-0"></div>

  <!-- Layer 7: Noise grain texture -->
  <div class="noise-layer absolute inset-0"></div>
</div>

<style>
  /* ============================
     AURORA BLOBS - large animated gradient orbs
     ============================ */
  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.12;
    will-change: transform;
  }

  :global(.dark) .aurora-blob {
    opacity: 0.18;
    filter: blur(100px);
  }

  .aurora-blob-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.6) 0%, rgba(6, 182, 212, 0) 70%);
    top: -10%;
    left: -5%;
    animation: auroraMove1 20s ease-in-out infinite;
  }

  .aurora-blob-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.5) 0%, rgba(59, 130, 246, 0) 70%);
    top: 30%;
    right: -8%;
    animation: auroraMove2 25s ease-in-out infinite;
  }

  .aurora-blob-3 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.4) 0%, rgba(139, 92, 246, 0) 70%);
    bottom: 10%;
    left: 20%;
    animation: auroraMove3 22s ease-in-out infinite;
  }

  .aurora-blob-4 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.35) 0%, rgba(34, 197, 94, 0) 70%);
    top: 60%;
    right: 25%;
    animation: auroraMove4 18s ease-in-out infinite;
  }

  .aurora-blob-5 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.3) 0%, rgba(59, 130, 246, 0.1) 40%, transparent 70%);
    top: 50%;
    left: 40%;
    transform: translate(-50%, -50%);
    animation: auroraMove5 30s ease-in-out infinite;
  }

  @keyframes auroraMove1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(80px, 50px) scale(1.1); }
    50% { transform: translate(40px, 100px) scale(0.95); }
    75% { transform: translate(-30px, 60px) scale(1.05); }
  }

  @keyframes auroraMove2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-60px, 40px) scale(1.15); }
    50% { transform: translate(-90px, -30px) scale(0.9); }
    75% { transform: translate(-20px, -60px) scale(1.05); }
  }

  @keyframes auroraMove3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(70px, -40px) scale(1.1); }
    66% { transform: translate(-40px, -80px) scale(0.95); }
  }

  @keyframes auroraMove4 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-80px, 50px) scale(1.2); }
  }

  @keyframes auroraMove5 {
    0%, 100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); }
    33% { transform: translate(-45%, -55%) scale(1.1) rotate(5deg); }
    66% { transform: translate(-55%, -45%) scale(0.9) rotate(-3deg); }
  }

  /* ============================
     FLOATING GEOMETRIC SHAPES
     ============================ */
  .geo-shape {
    position: absolute;
    will-change: transform;
  }

  .geo-hex {
    width: 40px;
    height: 46px;
    background: rgba(6, 182, 212, 0.04);
    border: 1.5px solid rgba(6, 182, 212, 0.12);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }
  :global(.dark) .geo-hex {
    background: rgba(6, 182, 212, 0.06);
    border-color: rgba(6, 182, 212, 0.22);
  }

  .geo-ring {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1.5px solid rgba(59, 130, 246, 0.1);
    background: transparent;
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.05);
  }
  :global(.dark) .geo-ring {
    border-color: rgba(59, 130, 246, 0.2);
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.08);
  }

  .geo-tri {
    width: 0;
    height: 0;
    border-left: 20px solid transparent;
    border-right: 20px solid transparent;
    border-bottom: 35px solid rgba(139, 92, 246, 0.06);
  }
  :global(.dark) .geo-tri {
    border-bottom-color: rgba(139, 92, 246, 0.12);
  }

  .geo-diamond {
    width: 30px;
    height: 30px;
    border: 1.5px solid rgba(34, 197, 94, 0.1);
    background: rgba(34, 197, 94, 0.03);
    transform: rotate(45deg);
  }
  :global(.dark) .geo-diamond {
    border-color: rgba(34, 197, 94, 0.2);
    background: rgba(34, 197, 94, 0.05);
  }

  .geo-1 { top: 8%; left: 12%; animation: geoFloat1 18s ease-in-out infinite; }
  .geo-2 { top: 15%; right: 18%; animation: geoFloat2 22s ease-in-out infinite; }
  .geo-3 { top: 35%; left: 8%; animation: geoFloat3 20s ease-in-out infinite; }
  .geo-4 { top: 55%; right: 10%; animation: geoFloat4 16s ease-in-out infinite; }
  .geo-5 { bottom: 20%; left: 25%; animation: geoFloat5 24s ease-in-out infinite; }
  .geo-6 { bottom: 30%; right: 20%; animation: geoFloat6 19s ease-in-out infinite; }
  .geo-7 { bottom: 10%; left: 6%; animation: geoFloat7 21s ease-in-out infinite; }
  .geo-8 { top: 75%; right: 5%; animation: geoFloat8 17s ease-in-out infinite; }

  @keyframes geoFloat1 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.4; }
    25% { transform: translate(20px, 30px) rotate(60deg); opacity: 0.7; }
    50% { transform: translate(-10px, 60px) rotate(120deg); opacity: 0.5; }
    75% { transform: translate(15px, 20px) rotate(200deg); opacity: 0.8; }
  }
  @keyframes geoFloat2 {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 0.3; }
    33% { transform: translate(-30px, 40px) rotate(90deg) scale(1.2); opacity: 0.6; }
    66% { transform: translate(20px, -20px) rotate(200deg) scale(0.8); opacity: 0.5; }
  }
  @keyframes geoFloat3 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.5; }
    50% { transform: translate(40px, -30px) rotate(180deg); opacity: 0.8; }
  }
  @keyframes geoFloat4 {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 0.4; }
    25% { transform: translate(-25px, -20px) rotate(45deg) scale(1.3); opacity: 0.7; }
    75% { transform: translate(15px, 30px) rotate(-30deg) scale(0.9); opacity: 0.5; }
  }
  @keyframes geoFloat5 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.3; }
    50% { transform: translate(-30px, -40px) rotate(120deg); opacity: 0.6; }
  }
  @keyframes geoFloat6 {
    0%, 100% { transform: translate(0, 0) rotate(45deg); opacity: 0.4; }
    33% { transform: translate(20px, -30px) rotate(90deg); opacity: 0.7; }
    66% { transform: translate(-15px, 20px) rotate(135deg); opacity: 0.5; }
  }
  @keyframes geoFloat7 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.5; }
    50% { transform: translate(50px, -20px) rotate(240deg); opacity: 0.8; }
  }
  @keyframes geoFloat8 {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 0.3; }
    50% { transform: translate(-40px, 30px) rotate(180deg) scale(1.4); opacity: 0.6; }
  }

  /* ============================
     SCAN LINE - subtle horizontal sweep
     ============================ */
  .scan-line {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(6, 182, 212, 0.03) 49%,
      rgba(6, 182, 212, 0.06) 50%,
      rgba(6, 182, 212, 0.03) 51%,
      transparent 100%
    );
    background-size: 100% 200%;
    animation: scanMove 6s linear infinite;
    opacity: 0.6;
  }

  :global(.dark) .scan-line {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(6, 182, 212, 0.04) 49%,
      rgba(6, 182, 212, 0.08) 50%,
      rgba(6, 182, 212, 0.04) 51%,
      transparent 100%
    );
    background-size: 100% 200%;
    opacity: 0.7;
  }

  @keyframes scanMove {
    0% { background-position: 0 200%; }
    100% { background-position: 0 -200%; }
  }

  /* ============================
     NOISE GRAIN TEXTURE
     ============================ */
  .noise-layer {
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
    mix-blend-mode: overlay;
  }

  :global(.dark) .noise-layer {
    opacity: 0.05;
  }

  /* ============================
     REDUCED MOTION
     ============================ */
  @media (prefers-reduced-motion: reduce) {
    .aurora-blob,
    .geo-shape,
    .scan-line {
      animation: none !important;
    }
    .aurora-blob {
      opacity: 0.06;
    }
    :global(.dark) .aurora-blob {
      opacity: 0.1;
    }
    .scan-line {
      display: none;
    }
  }
</style>
