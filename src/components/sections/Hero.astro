---
import type { Locale } from '../../i18n/config';
import { routeMap } from '../../i18n/config';
import { t } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const routes = routeMap[locale];
---

<section class="relative min-h-screen flex items-center overflow-hidden">
<Container class="relative z-10 pt-32 pb-20">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Headline -->
      <h1 class="text-[clamp(1.75rem,7vw,3rem)] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.5rem] font-bold tracking-tight leading-[1.08] mb-8 break-words hyphens-auto animate-fade-in-up animate-delay-2">
        <span class="text-[var(--color-text-primary)] dark:text-white">
          {locale === 'de' ? 'Wir entwickeln' : 'We develop'}
        </span>
        <br />
        <span id="cyber-text-wrap" data-locale={locale}>
          <span id="cyber-text" class="gradient-text">{locale === 'de' ? 'innovative' : 'innovative'}<br />{locale === 'de' ? 'Softwarelösungen' : 'Software Solutions'}</span>
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl lg:text-2xl text-[var(--color-text-secondary)] dark:text-white/70 max-w-3xl mx-auto mb-12 animate-fade-in-up animate-delay-3 leading-relaxed" data-text-reveal>
        {t(locale, 'hero.subtitle')}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up animate-delay-4">
        <Button href={routes.contact} variant="primary" size="lg">
          {t(locale, 'hero.cta')}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </Button>
        <a
          href={routes.products}
          class="inline-flex items-center gap-2 px-8 py-3 rounded-lg font-medium text-[var(--color-text-primary)] dark:text-white/90 border border-[var(--color-border)] dark:border-white/20 backdrop-blur-sm hover:bg-[var(--color-text-primary)]/5 dark:hover:bg-white/10 transition-all"
        >
          {t(locale, 'hero.ctaSecondary')}
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="mt-20 animate-fade-in-up animate-delay-5">
        <div class="flex flex-col items-center gap-2 text-[var(--color-text-tertiary)] dark:text-white/40">
          <span class="text-xs uppercase tracking-widest">{locale === 'de' ? 'Scrollen' : 'Scroll'}</span>
          <div class="w-5 h-8 rounded-full border-2 border-[var(--color-border)] dark:border-white/20 flex items-start justify-center p-1">
            <div class="w-1 h-2 bg-[var(--color-text-tertiary)] dark:bg-white/40 rounded-full animate-bounce"></div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <!-- Bottom gradient fade -->
  <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[var(--color-surface-primary)] dark:from-[var(--color-dark-bg)] to-transparent" aria-hidden="true"></div>
</section>

<style is:global>
  #cyber-text-wrap {
    display: block;
    min-height: 2.1em;
  }
  #cyber-text {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    #cyber-text { transition: none; }
  }
</style>

<script is:inline>
  (function() {
    var textEl = document.getElementById('cyber-text');
    var wrap = document.getElementById('cyber-text-wrap');
    if (!textEl || !wrap) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var locale = wrap.getAttribute('data-locale') || 'de';
    var words = locale === 'de'
      ? ['innovative\nSoftwarelösungen', 'sichere\nIT-Systeme', 'digitale\nKommunikation', 'individuelle\nMobile Apps', 'skalierbare\nInfrastruktur']
      : ['innovative\nSoftware Solutions', 'secure\nIT Systems', 'digital\nCommunication', 'custom\nMobile Apps', 'scalable\nInfrastructure'];

    var currentIndex = 0;
    var holdTime = 3000;
    var running = false;
    var scrambleChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';

    function scrambleTo(callback) {
      currentIndex = (currentIndex + 1) % words.length;
      var target = words[currentIndex];
      var len = target.length;
      // Each char gets a random number of scramble iterations before resolving
      var charIterations = [];
      var visibleIdx = 0;
      for (var i = 0; i < len; i++) {
        if (target[i] === '\n' || target[i] === ' ') {
          charIterations.push(0);
        } else {
          charIterations.push(3 + Math.floor(Math.random() * 6) + Math.floor(visibleIdx * 0.5));
          visibleIdx++;
        }
      }
      var maxIter = Math.max.apply(null, charIterations);
      var count = 0;

      var interval = setInterval(function() {
        count++;
        var result = '';
        for (var j = 0; j < len; j++) {
          if (target[j] === '\n' || target[j] === ' ') {
            result += target[j];
          } else if (count >= charIterations[j]) {
            result += target[j];
          } else {
            result += scrambleChars[Math.floor(Math.random() * scrambleChars.length)];
          }
        }
        textEl.innerHTML = result.replace(/\n/g, '<br>');

        if (count >= maxIter) {
          clearInterval(interval);
          textEl.innerHTML = target.replace(/\n/g, '<br>');
          callback();
        }
      }, 40);
    }

    function nextWord() {
      if (running) return;
      running = true;

      scrambleTo(function() {
        running = false;
        setTimeout(nextWord, holdTime);
      });
    }

    setTimeout(nextWord, holdTime);
  })();
</script>
