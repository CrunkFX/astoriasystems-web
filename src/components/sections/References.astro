---
import type { Locale } from '../../i18n/config';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import GlassCard from '../ui/GlassCard.astro';
import { caseStudies, focusAreas } from '../../data/references';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const ui = {
  de: { eyebrow: 'Referenzen', title: 'Projekte & Partner, die auf uns setzen', subtitle: 'Von Kommunikation über IT-Sicherheit bis zu individueller Software – ein Einblick in unsere Arbeit und unser Partnernetzwerk.', highlights: 'Weitere Schwerpunkte' },
  en: { eyebrow: 'References', title: 'Projects & partners who rely on us', subtitle: 'From communication and IT security to custom software – a look at our work and our partner network.', highlights: 'More focus areas' },
}[locale];
---

<Section class="!pt-28 lg:!pt-32 !pb-16 lg:!pb-24 overflow-hidden">
  <Container>
    <slot name="breadcrumb" />
    <!-- Hero -->
    <div class="max-w-3xl" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {ui.eyebrow}
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 break-words hyphens-auto" data-text-reveal>
        {ui.title}
      </h1>
      <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
        {ui.subtitle}
      </p>
    </div>

    <!-- Case Studies (datengetrieben, siehe src/data/references.ts) -->
    {caseStudies.map((cs) => (
      <article class="mt-16 lg:mt-20" data-reveal>
        <span class="inline-block text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">
          {cs.tag[locale]}
        </span>
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="text-2xl md:text-3xl font-bold break-words hyphens-auto">{cs.title[locale]}</h2>
          {cs.clientLogo && (
            <span class="shrink-0">
              <img src={cs.clientLogo.light} alt={cs.clientLogo.alt} class="h-8 w-auto max-w-[160px] object-contain dark:hidden" loading="lazy" onerror="this.remove()" />
              <img src={cs.clientLogo.dark} alt={cs.clientLogo.alt} class="h-8 w-auto max-w-[160px] object-contain hidden dark:block" loading="lazy" onerror="this.remove()" />
            </span>
          )}
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
          <div class="flex flex-col">
            <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed mb-5 break-words">
              {cs.lead[locale]}
            </p>
            <ul class="space-y-2.5 mb-6">
              {cs.bullets[locale].map((b) => (
                <li class="flex items-start gap-2.5 text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
                  <svg class="h-5 w-5 shrink-0 mt-0.5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span class="break-words">{b}</span>
                </li>
              ))}
            </ul>

            {cs.gallery && (
              <div class="relative mb-6 h-64 sm:h-72 lg:h-auto lg:flex-1 lg:min-h-0" data-slider>
                <div class="ref-slider-track no-scrollbar absolute inset-0 flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-xl">
                  {cs.gallery.map((img) => (
                    <div class="snap-center shrink-0 h-full rounded-xl overflow-hidden border border-[var(--color-border)] dark:border-white/10 bg-[var(--color-surface-tertiary)] dark:bg-[var(--color-dark-surface-secondary)] flex items-center justify-center">
                      <img src={img.src} alt={img.alt} class:list={['h-full w-auto max-w-none', img.fit === 'contain' ? 'object-contain p-2' : 'object-cover']} loading="lazy" onerror="this.closest('div').remove()" />
                    </div>
                  ))}
                </div>
                <button type="button" class="ref-slider-prev absolute left-2 top-1/2 -translate-y-1/2 h-9 w-9 rounded-full bg-white/90 dark:bg-[#030712]/80 border border-[var(--color-border)] dark:border-white/15 shadow flex items-center justify-center hover:text-[var(--color-accent)] transition-colors" aria-label="Zurück">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>
                <button type="button" class="ref-slider-next absolute right-2 top-1/2 -translate-y-1/2 h-9 w-9 rounded-full bg-white/90 dark:bg-[#030712]/80 border border-[var(--color-border)] dark:border-white/15 shadow flex items-center justify-center hover:text-[var(--color-accent)] transition-colors" aria-label="Weiter">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </button>
              </div>
            )}

            {cs.links && (
              <div class="flex flex-wrap gap-3 mt-auto">
                {cs.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg border border-[var(--color-border)] dark:border-white/15 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">
                    {l.label}
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-8.25 8.25M16.5 18.75h-9a1.5 1.5 0 01-1.5-1.5v-9" />
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>

          {cs.testimonial && (
            <GlassCard class="p-7 lg:p-8">
              <div class="flex items-center gap-4 mb-5">
                <div class="relative h-16 w-16 shrink-0 rounded-full overflow-hidden bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-light)] flex items-center justify-center">
                  <span class="text-[#052b30] font-bold text-lg">{cs.testimonial.person.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
                  {cs.testimonial.photo && (
                    <img src={cs.testimonial.photo} alt={`${cs.testimonial.person}, ${cs.testimonial.role[locale]}`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" onerror="this.remove()" />
                  )}
                </div>
                <div>
                  <div class="font-semibold">{cs.testimonial.person}</div>
                  <div class="text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">{cs.testimonial.role[locale]}</div>
                </div>
              </div>
              <blockquote class="text-lg leading-relaxed mb-6 break-words">{cs.testimonial.quote[locale]}</blockquote>
              {cs.testimonial.interview && (
                <div class="space-y-4 border-t border-[var(--color-border)] dark:border-white/10 pt-5">
                  {cs.testimonial.interview.map((i) => (
                    <div>
                      <p class="font-semibold text-sm mb-1 break-words">{i.q[locale]}</p>
                      <p class="text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed break-words">{i.a[locale]}</p>
                    </div>
                  ))}
                </div>
              )}
            </GlassCard>
          )}
        </div>
      </article>
    ))}

    <!-- Allgemeine Schwerpunkte -->
    <h2 class="text-2xl md:text-3xl font-bold mt-20 mb-8" data-reveal>{ui.highlights}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {focusAreas.map((p) => (
        <GlassCard class="p-6 glass-hover">
          <span class="inline-block text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">{p.tag[locale]}</span>
          <h3 class="text-xl font-bold mb-2 break-words hyphens-auto">{p.title[locale]}</h3>
          <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed break-words">{p.desc[locale]}</p>
        </GlassCard>
      ))}
    </div>
  </Container>
</Section>

<script is:inline>
  document.querySelectorAll('[data-slider]').forEach(function (s) {
    var track = s.querySelector('.ref-slider-track');
    if (!track) return;
    function step() {
      var first = track.querySelector('div');
      return first ? first.offsetWidth + 12 : track.clientWidth * 0.8;
    }
    var prev = s.querySelector('.ref-slider-prev');
    var next = s.querySelector('.ref-slider-next');
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });

    // Autoscroll (pausiert bei Interaktion, respektiert reduced motion)
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timer = null;
    function tick() {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      }
    }
    function start() { if (reduce) return; stop(); timer = setInterval(tick, 3500); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    start();
    ['pointerenter', 'focusin', 'touchstart'].forEach(function (ev) { s.addEventListener(ev, stop, { passive: true }); });
    ['pointerleave', 'focusout', 'touchend'].forEach(function (ev) { s.addEventListener(ev, start, { passive: true }); });
  });
</script>
