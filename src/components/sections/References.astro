---
import type { Locale } from '../../i18n/config';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import GlassCard from '../ui/GlassCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  de: {
    eyebrow: 'Referenzen',
    title: 'Projekte & Partner, die auf uns setzen',
    subtitle:
      'Von Kommunikation über IT-Sicherheit bis zu individueller Software – ein Einblick in unsere Arbeit und unser Partnernetzwerk.',
    caseEyebrow: 'Case Study · iOS · LiDAR',
    caseTitle: 'mkmScan – Wohnflächenberechnung per LiDAR',
    caseLead:
      'Für die mkm International GmbH haben wir mkmScan entwickelt – eine iOS-App, die mit dem Apple-LiDAR-Scanner direkt aus dem Raum heraus die Wohnfläche berechnet. Durch die Kombination aus 3D-Scan und Texturerfassung erreicht die App eine Genauigkeit und Auswertungstiefe, die es in dieser Form am Markt bislang nicht gab.',
    caseBullets: [
      'Direkte Wohnflächenberechnung per iPhone – ohne Maßband oder Zusatzhardware',
      'Apple-LiDAR kombiniert mit Texturerfassung für hohe Genauigkeit',
      'Auswertung und Aufmaß direkt in der App',
    ],
    quote:
      '„Astoria Systems hat mit mkmScan etwas umgesetzt, das es so am Markt nicht gibt: eine direkte, verlässliche Wohnflächenberechnung allein per Smartphone. Die Verbindung aus Apple-LiDAR und Texturerfassung hebt Genauigkeit und Auswertung auf ein völlig neues Niveau – technologisch ein echter Sprung und in der Umsetzung herausragend."',
    person: 'Markus G. Schlegel',
    role: 'CSO, mkm International GmbH',
    interview: [
      {
        q: 'Was macht mkmScan besonders?',
        a: '„Wir vermessen Wohnflächen heute direkt mit dem iPhone – ohne Maßband, ohne Zusatzgeräte. Dass das in dieser Präzision funktioniert, war noch vor Kurzem undenkbar."',
      },
      {
        q: 'Wie war die Zusammenarbeit mit Astoria Systems?',
        a: '„Hervorragend. Das Team hat die LiDAR-Technologie nicht nur beherrscht, sondern mit der Texturauswertung clever weitergedacht – schnell, lösungsorientiert und auf einem technisch sehr hohen Niveau."',
      },
    ],
    highlights: 'Weitere Schwerpunkte',
    projects: [
      { tag: 'Kommunikation', title: 'Unternehmensweite Kommunikationsplattform', desc: 'VoIP-Telefonie, Team- und Kundenchat sowie KI-gestützte Bots – interne und externe Kommunikation aus einer Hand.' },
      { tag: 'IT-Sicherheit', title: 'Sichere, DSGVO-konforme Infrastruktur', desc: 'Härtung, Verschlüsselung und kontinuierliches Monitoring für ausfallsichere Systeme mit Hosting in der EU.' },
      { tag: 'Infrastruktur', title: 'Skalierbare Cloud- & Server-Landschaften', desc: 'Planung, Migration und Betrieb performanter Infrastruktur – flexibel mitwachsend mit dem Unternehmen.' },
      { tag: 'Software', title: 'Individuelle Software, Web- & Mobile-Apps', desc: 'Maßgeschneiderte ERP-/CRM-Systeme und Anwendungen, exakt auf bestehende Prozesse zugeschnitten.' },
    ],
  },
  en: {
    eyebrow: 'References',
    title: 'Projects & partners who rely on us',
    subtitle:
      'From communication and IT security to custom software – a look at our work and our partner network.',
    caseEyebrow: 'Case study · iOS · LiDAR',
    caseTitle: 'mkmScan – living-space measurement via LiDAR',
    caseLead:
      'For mkm International GmbH we built mkmScan – an iOS app that uses the Apple LiDAR scanner to calculate living space directly from the room. By combining 3D scanning with texture capture, the app achieves a level of accuracy and analysis that did not exist in this form on the market.',
    caseBullets: [
      'Direct living-space measurement on iPhone – no tape measure or extra hardware',
      'Apple LiDAR combined with texture capture for high accuracy',
      'Analysis and measurement right inside the app',
    ],
    quote:
      '“With mkmScan, Astoria Systems delivered something the market simply didn’t have: reliable living-space measurement from a smartphone alone. Combining Apple LiDAR with texture capture takes accuracy and analysis to a whole new level – a real technological leap, brilliantly executed.”',
    person: 'Markus G. Schlegel',
    role: 'CSO, mkm International GmbH',
    interview: [
      {
        q: 'What makes mkmScan special?',
        a: '“We now measure living space directly with an iPhone – no tape measure, no extra devices. That this works at such precision was unthinkable not long ago.”',
      },
      {
        q: 'How was working with Astoria Systems?',
        a: '“Excellent. The team not only mastered the LiDAR technology but cleverly extended it with texture analysis – fast, solution-oriented and at a very high technical level.”',
      },
    ],
    highlights: 'More focus areas',
    projects: [
      { tag: 'Communication', title: 'Company-wide communication platform', desc: 'VoIP telephony, team and customer chat plus AI-powered bots – internal and external communication from a single source.' },
      { tag: 'IT security', title: 'Secure, GDPR-compliant infrastructure', desc: 'Hardening, encryption and continuous monitoring for resilient systems hosted in the EU.' },
      { tag: 'Infrastructure', title: 'Scalable cloud & server landscapes', desc: 'Planning, migration and operation of high-performance infrastructure that grows with your business.' },
      { tag: 'Software', title: 'Custom software, web & mobile apps', desc: 'Tailored ERP/CRM systems and applications, built precisely around your existing processes.' },
    ],
  },
}[locale];

const links = [
  { label: 'App Store', href: 'https://apps.apple.com/de/app/mkmscan/id6736586301' },
  { label: 'Immobilienmesse', href: 'https://immobilienmesse.de/produkte/mkmscan' },
  { label: 'mkmfloor.de', href: 'https://www.mkmfloor.de/' },
];
---

<Section class="!pt-28 lg:!pt-32 !pb-16 lg:!pb-24 overflow-hidden">
  <Container>
    <!-- Hero -->
    <div class="max-w-3xl" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {content.eyebrow}
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 break-words hyphens-auto" data-text-reveal>
        {content.title}
      </h1>
      <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
        {content.subtitle}
      </p>
    </div>

    <!-- Featured case study: mkmScan -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start" data-reveal>
      <div>
        <span class="inline-block text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">
          {content.caseEyebrow}
        </span>
        <h2 class="text-2xl md:text-3xl font-bold mb-4 break-words hyphens-auto">{content.caseTitle}</h2>
        <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed mb-5 break-words">
          {content.caseLead}
        </p>
        <ul class="space-y-2.5 mb-6">
          {content.caseBullets.map((b) => (
            <li class="flex items-start gap-2.5 text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
              <svg class="h-5 w-5 shrink-0 mt-0.5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="break-words">{b}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3">
          {links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg border border-[var(--color-border)] dark:border-white/15 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
            >
              {l.label}
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-8.25 8.25M16.5 18.75h-9a1.5 1.5 0 01-1.5-1.5v-9" />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Testimonial + Interview -->
      <GlassCard class="p-7 lg:p-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="relative h-16 w-16 shrink-0 rounded-full overflow-hidden bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-light)] flex items-center justify-center">
            <span class="text-[#052b30] font-bold text-lg">MS</span>
            <img
              src="/images/references/markus-schlegel.jpg"
              alt={`${content.person}, ${content.role}`}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              onerror="this.remove()"
            />
          </div>
          <div>
            <div class="font-semibold">{content.person}</div>
            <div class="text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">{content.role}</div>
          </div>
        </div>
        <blockquote class="text-lg leading-relaxed mb-6 break-words">{content.quote}</blockquote>
        <div class="space-y-4 border-t border-[var(--color-border)] dark:border-white/10 pt-5">
          {content.interview.map((i) => (
            <div>
              <p class="font-semibold text-sm mb-1 break-words">{i.q}</p>
              <p class="text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed break-words">{i.a}</p>
            </div>
          ))}
        </div>
      </GlassCard>
    </div>

    <!--
      Weitere Schwerpunkte: repräsentative Leistungsbereiche. Bei Bedarf durch
      konkrete Kundenprojekte / Case Studies ersetzen.
    -->
    <h2 class="text-2xl md:text-3xl font-bold mt-20 mb-8" data-reveal>{content.highlights}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {content.projects.map((p) => (
        <GlassCard class="p-6 glass-hover">
          <span class="inline-block text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-3">
            {p.tag}
          </span>
          <h3 class="text-xl font-bold mb-2 break-words hyphens-auto">{p.title}</h3>
          <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed break-words">
            {p.desc}
          </p>
        </GlassCard>
      ))}
    </div>
  </Container>
</Section>
