---
import type { Locale } from '../../i18n/config';
import type { ExpertiseArea } from '../../data/expertise';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  area: ExpertiseArea;
  locale: Locale;
}

const { area, locale } = Astro.props;
const backLabel = locale === 'de' ? 'Alle Themen' : 'All topics';
const backHref = locale === 'de' ? '/expertise' : '/en/expertise';
---

<Section class="!pt-28 lg:!pt-32 !pb-16 lg:!pb-24 overflow-hidden">
  <Container>
    <slot name="breadcrumb" />

    <!-- Header -->
    <div class="max-w-3xl" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {area.category[locale]}
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-6 break-words hyphens-auto" data-text-reveal>
        {area.title[locale]}
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
        {area.lead[locale]}
      </p>
    </div>

    <!-- Hero image (Fallback: Verlauf + Icon) -->
    <div class="exp-media relative w-full aspect-[16/9] md:aspect-[21/9] rounded-2xl overflow-hidden border border-[var(--color-border)] dark:border-white/10 bg-gradient-to-br from-[#0e7490]/15 to-[#2dd4bf]/10 flex items-center justify-center mt-10" data-reveal>
      <svg class="h-24 w-24 text-[var(--color-accent-dark)]/40 dark:text-[var(--color-accent)]/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
        <Fragment set:html={area.icon} />
      </svg>
      {area.image && (
        <img src={area.image} alt={area.title[locale]} class="absolute inset-0 h-full w-full object-cover" loading="eager" onerror="this.remove()" />
      )}
    </div>

    <!-- Tech logos -->
    {area.logos && (
      <div class="flex flex-wrap items-center gap-3 mt-8" data-reveal>
        {area.logos.map((logo) => (
          <span class="inline-flex items-center justify-center h-10 px-4 rounded-md bg-white border border-[var(--color-border)]">
            <img src={logo.src} alt={logo.alt} class="h-6 w-auto max-w-[130px] object-contain" loading="lazy" onerror="this.closest('span').remove()" />
          </span>
        ))}
      </div>
    )}

    <!-- Article body -->
    <div class="max-w-3xl mt-12 lg:mt-16 space-y-10">
      {area.sections.map((sec) => (
        <div data-reveal>
          <h2 class="text-2xl md:text-3xl font-bold mb-4 break-words hyphens-auto">{sec.heading[locale]}</h2>
          <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed break-words">
            {sec.body[locale]}
          </p>
          {sec.bullets && (
            <ul class="mt-4 space-y-2.5">
              {sec.bullets[locale].map((b) => (
                <li class="flex items-start gap-2.5 text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
                  <svg class="h-5 w-5 shrink-0 mt-0.5 text-[var(--color-accent-dark)] dark:text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span class="break-words">{b}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <!-- Tags -->
    <div class="max-w-3xl mt-12 flex flex-wrap gap-2" data-reveal>
      {area.tags.map((tag) => (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] bg-[var(--color-surface-tertiary)] dark:bg-[var(--color-dark-surface-secondary)] border border-[var(--color-border)] dark:border-white/10">
          {tag}
        </span>
      ))}
    </div>

    <div class="mt-12">
      <a href={backHref} class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-accent-dark)] dark:text-[var(--color-accent)] hover:underline">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
        {backLabel}
      </a>
    </div>
  </Container>
</Section>
