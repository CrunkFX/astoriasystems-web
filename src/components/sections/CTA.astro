---
import type { Locale } from '../../i18n/config';
import { routeMap } from '../../i18n/config';
import { t } from '../../i18n/utils';
import Container from '../ui/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const routes = routeMap[locale];
---

<section class="relative py-32 lg:py-40 overflow-hidden" data-reveal>
  <!-- Background with pattern -->
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent-dark)]/85 via-[var(--color-accent)]/80 to-blue-600/75"></div>
  <div class="absolute inset-0 grid-pattern opacity-15"></div>
  <!-- Subtle orb -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-white/5 rounded-full blur-[100px]" aria-hidden="true"></div>

  <Container class="relative z-10 text-center">
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6" data-text-reveal>
      {t(locale, 'cta.title')}
    </h2>
    <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-10">
      {t(locale, 'cta.subtitle')}
    </p>
    <a
      href={routes.contact}
      class="inline-flex items-center gap-3 px-10 py-4 bg-white text-[var(--color-accent-dark)] rounded-xl font-semibold text-lg hover:bg-white/90 transition-all hover:shadow-lg hover:shadow-white/20 hover:-translate-y-0.5"
    >
      {t(locale, 'cta.button')}
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </Container>
</section>
