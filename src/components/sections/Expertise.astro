---
import type { Locale } from '../../i18n/config';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import GlassCard from '../ui/GlassCard.astro';
import { expertiseAreas } from '../../data/expertise';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = locale === 'de' ? '/expertise' : '/en/expertise';

const ui = {
  de: {
    eyebrow: 'Expertise',
    title: 'Tiefe Technik-Expertise, auf die Sie zählen können',
    subtitle: 'Spezialisierte Kompetenzen für anspruchsvolle Infrastruktur, Sicherheit und Automatisierung – mit echter Tiefe statt Schlagworten.',
    more: 'Mehr erfahren',
  },
  en: {
    eyebrow: 'Expertise',
    title: 'Deep technical expertise you can rely on',
    subtitle: 'Specialized capabilities for demanding infrastructure, security and automation – with real depth, not buzzwords.',
    more: 'Learn more',
  },
}[locale];
---

<Section class="!pt-28 lg:!pt-32 !pb-16 lg:!pb-24 overflow-hidden">
  <Container>
    <slot name="breadcrumb" />
    <div class="max-w-3xl mb-14 lg:mb-16" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {ui.eyebrow}
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 break-words hyphens-auto" data-text-reveal>
        {ui.title}
      </h1>
      <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
        {ui.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {expertiseAreas.map((area) => (
        <a href={`${base}/${area.slug}`} class="group block h-full">
          <GlassCard class="glass-hover p-7 h-full flex flex-col">
            <span class="icon-lowpoly inline-flex h-12 w-12 items-center justify-center rounded-xl text-white bg-gradient-to-br from-[#0e7490] to-[#2dd4bf] mb-5">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <Fragment set:html={area.icon} />
              </svg>
            </span>
            <span class="text-xs font-semibold text-[var(--color-accent-dark)] dark:text-[var(--color-accent)] uppercase tracking-widest mb-2">
              {area.category[locale]}
            </span>
            <h2 class="text-xl font-bold mb-3 break-words hyphens-auto">{area.title[locale]}</h2>
            <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed mb-5 break-words">
              {area.summary[locale]}
            </p>
            <span class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-[var(--color-accent-dark)] dark:text-[var(--color-accent)]">
              {ui.more}
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </GlassCard>
        </a>
      ))}
    </div>
  </Container>
</Section>
