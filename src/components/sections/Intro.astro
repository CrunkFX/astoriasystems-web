---
import type { Locale } from '../../i18n/config';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  de: {
    eyebrow: 'Ihr IT-Partner',
    title: 'Ganzheitliche IT-Lösungen für Unternehmen',
    p1: 'Astoria Systems ist Ihr Partner für moderne Unternehmens-IT. Von sicherer Kommunikation über VoIP, Chat und E-Mail bis zur digitalen Infrastruktur planen, betreiben und schützen wir Ihre Systeme – durchgängig DSGVO-konform und mit Hosting in der EU.',
    p2: 'Unser Team entwickelt individuelle Softwarelösungen, Web- und Mobile-Apps sowie maßgeschneiderte ERP- und CRM-Systeme, die exakt zu Ihren Prozessen passen. Mit klarem Fokus auf IT-Sicherheit und langfristige Partnerschaft begleiten wir Unternehmen jeder Größe zuverlässig in die digitale Zukunft – standortunabhängig und weltweit.',
  },
  en: {
    eyebrow: 'Your IT partner',
    title: 'End-to-end IT solutions for businesses',
    p1: 'Astoria Systems is your partner for modern business IT. From secure communication via VoIP, chat and email to digital infrastructure, we plan, operate and protect your systems – fully GDPR-compliant and hosted in the EU.',
    p2: 'Our team builds custom software solutions, web and mobile apps as well as tailored ERP and CRM systems that fit your processes precisely. With a clear focus on IT security and long-term partnership, we reliably guide companies of all sizes into the digital future – location-independent and worldwide.',
  },
}[locale];
---

<Section variant="alt" class="!py-16 lg:!py-24">
  <Container>
    <div class="max-w-3xl mx-auto text-center" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {content.eyebrow}
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6 break-words hyphens-auto leading-tight">
        {content.title}
      </h2>
      <p class="text-base md:text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed mb-4 break-words">
        {content.p1}
      </p>
      <p class="text-base md:text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed break-words">
        {content.p2}
      </p>
    </div>
  </Container>
</Section>
