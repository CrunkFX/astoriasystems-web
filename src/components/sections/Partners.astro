---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const partners = [
  { name: 'Odoo', url: 'https://www.odoo.com', logo: '/images/partners/odoo.svg' },
  { name: 'OVHcloud', url: 'https://www.ovhcloud.com', logo: '/images/partners/ovhcloud.svg' },
  { name: 'Netcup', url: 'https://www.netcup.de', logo: '/images/partners/netcup.svg' },
  { name: 'Nano Fassadendämmung', url: 'https://www.nanofassadendaemmung.de', logo: '/images/partners/nano.svg' },
  { name: 'mkmFloor', url: 'https://www.mkmfloor.de', logo: '/images/partners/mkmfloor.svg' },
  { name: 'BauPVO e.V.', url: 'https://www.baupvo.de', logo: '/images/partners/baupvo.svg' },
];
---

<Section class="!py-20 lg:!py-28">
  <Container>
    <div class="text-center mb-12" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {locale === 'de' ? 'Unsere Partner' : 'Our Partners'}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{t(locale, 'partners.title')}</h2>
      <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
        {t(locale, 'partners.subtitle')}
      </p>
    </div>

    <!-- Marquee scrolling logos -->
    <div class="overflow-hidden" data-reveal>
      <div class="partner-marquee flex">
        <!-- First set -->
        <div class="partner-marquee-track flex items-center gap-8 shrink-0">
          {partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-[180px] py-3 shrink-0 opacity-60 hover:opacity-100 transition-opacity"
              aria-label={partner.name}
            >
              <img
                src={partner.logo}
                alt={partner.name}
                class="h-8 w-auto max-w-[140px] object-contain dark:brightness-0 dark:invert"
              />
            </a>
          ))}
        </div>
        <!-- Duplicate set for seamless loop -->
        <div class="partner-marquee-track flex items-center gap-8 shrink-0" aria-hidden="true">
          {partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-[180px] py-3 shrink-0 opacity-60 hover:opacity-100 transition-opacity"
              tabindex="-1"
            >
              <img
                src={partner.logo}
                alt=""
                class="h-8 w-auto max-w-[140px] object-contain dark:brightness-0 dark:invert"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .partner-marquee {
    animation: partner-scroll 15s linear infinite;
  }
  .partner-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes partner-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-marquee { animation: none; }
  }
</style>
