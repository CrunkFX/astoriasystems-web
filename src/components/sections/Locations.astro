---
import type { Locale } from '../../i18n/config';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import GlassCard from '../ui/GlassCard.astro';
// Offizielle Deutschland-SVG (Wikimedia) als Rohtext zur Build-Zeit.
// Inhalt von src/data/germany.svg = die unveränderte Karte.
import germanyRaw from '../../data/germany.svg?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const ui = {
  de: { eyebrow: 'Standorte', title: 'Unsere Standorte', route: 'Route planen' },
  en: { eyebrow: 'Locations', title: 'Our locations', route: 'Get directions' },
}[locale];

const locations = [
  {
    name: 'Bad Kreuznach',
    badge: { de: 'Hauptsitz', en: 'Headquarters' },
    lines: ['Astoria Systems GmbH', 'Bosenheimer Straße 219', '55543 Bad Kreuznach'],
    note: { de: 'Haupt- & Postanschrift', en: 'Main & postal address' },
    maps: 'https://www.google.com/maps/search/?api=1&query=Bosenheimer%20Stra%C3%9Fe%20219%2C%2055543%20Bad%20Kreuznach',
  },
  {
    name: 'Kleve',
    badge: { de: 'Standort', en: 'Office' },
    lines: ['c/o mkm International GmbH', 'Boschstraße 16', '47533 Kleve'],
    note: { de: 'Standort', en: 'Office' },
    maps: 'https://www.google.com/maps/search/?api=1&query=Boschstra%C3%9Fe%2016%2C%2047533%20Kleve',
  },
];

// Pin-Positionen im Koordinatensystem der offiziellen SVG (viewBox 591.504 x 800.504),
// kalibriert per affiner Transformation über bekannte Städte (Berlin/Hamburg).
const pins = [
  { name: 'Bad Kreuznach', x: 136.6, y: 522.3, anchor: 'start' as const, dx: 14 },
  { name: 'Kleve', x: 29.3, y: 330.3, anchor: 'start' as const, dx: 14 },
];
---

<Section variant="alt" class="overflow-hidden">
  <Container>
    <div class="max-w-3xl mb-12" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">{ui.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-bold">{ui.title}</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
      <!-- Echte Deutschland-Karte (CI-gefärbt) + 3D-Pins -->
      <div class="order-2 lg:order-1 flex justify-center" data-reveal>
        <div class="de-map relative w-full max-w-[480px]">
          <Fragment set:html={germanyRaw} />
          <svg viewBox="0 0 591.504 800.504" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
            <defs>
              <radialGradient id="pin3d" cx="35%" cy="28%" r="80%">
                <stop offset="0%" stop-color="#9af4ff" />
                <stop offset="42%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#0b6f7a" />
              </radialGradient>
              <filter id="pinShadow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="2" />
              </filter>
            </defs>
            {pins.map((p) => (
              <g transform={`translate(${p.x} ${p.y})`}>
                <ellipse cx="0" cy="3" rx="9" ry="3" fill="#000" opacity="0.35" filter="url(#pinShadow)" />
                <path d="M0 0 C -7 -12 -15 -18 -15 -26 A 15 15 0 1 1 15 -26 C 15 -18 7 -12 0 0 Z" fill="url(#pin3d)" stroke="#0a6b75" stroke-width="0.8" />
                <circle cx="0" cy="-26" r="6.2" fill="#06141b" />
                <circle cx="-4.2" cy="-31" r="2.3" fill="#ffffff" opacity="0.7" />
                <text x={p.dx} y="-20" class="de-pin-label" text-anchor={p.anchor}>{p.name}</text>
              </g>
            ))}
          </svg>
        </div>
      </div>

      <!-- Adress-Karten -->
      <div class="order-1 lg:order-2 space-y-6" data-reveal data-reveal-delay="2">
        {locations.map((loc) => (
          <GlassCard class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-white bg-gradient-to-br from-[#0e7490] to-[#2dd4bf]">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </span>
              <div>
                <h3 class="text-lg font-bold leading-tight">{loc.name}</h3>
                <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent-dark)] dark:text-[var(--color-accent)]">{loc.badge[locale]}</span>
              </div>
            </div>
            <address class="not-italic text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
              {loc.lines.map((line) => (<span class="block">{line}</span>))}
            </address>
            <p class="text-xs text-[var(--color-text-tertiary)] dark:text-[var(--color-dark-text-tertiary)] mt-2">{loc.note[locale]}</p>
            <a href={loc.maps} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-4 text-sm font-medium text-[var(--color-accent-dark)] dark:text-[var(--color-accent)] hover:underline">
              {ui.route}
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-8.25 8.25M16.5 18.75h-9a1.5 1.5 0 01-1.5-1.5v-9" /></svg>
            </a>
          </GlassCard>
        ))}
      </div>
    </div>
  </Container>
</Section>

<style is:global>
  /* Eingebettete offizielle Karte responsiv + im CI umfärben.
     Gezielt auf die Karten-SVG (#Bundesrepublik_Deutschland), damit die
     Pin-Overlay-SVG nicht mitgefärbt wird. */
  .de-map > svg#Bundesrepublik_Deutschland {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Hell: dunkleres Teal für gute Sichtbarkeit auf hellem Grund */
  .de-map #Bundesrepublik_Deutschland path {
    fill: rgba(46, 154, 160, 0.20) !important;
    stroke: rgba(46, 154, 160, 0.55) !important;
    stroke-width: 0.55 !important;
  }
  .de-map #Bundesrepublik_Deutschland #path3789 {
    fill: none !important;
    stroke: #2e9aa0 !important;
    stroke-width: 1.5 !important;
    filter: drop-shadow(0 0 2px rgba(46, 154, 160, 0.45));
  }
  /* Dunkel: helles Cyan + Glow */
  .dark .de-map > svg#Bundesrepublik_Deutschland {
    filter: drop-shadow(0 0 7px rgba(0, 229, 255, 0.18));
  }
  .dark .de-map #Bundesrepublik_Deutschland path {
    fill: rgba(0, 229, 255, 0.13) !important;
    stroke: rgba(0, 229, 255, 0.42) !important;
  }
  .dark .de-map #Bundesrepublik_Deutschland #path3789 {
    stroke: rgba(0, 229, 255, 0.85) !important;
    filter: drop-shadow(0 0 3px rgba(0, 229, 255, 0.55));
  }

  /* Labels: starker Halo in Hintergrundfarbe → in beiden Themes lesbar */
  .de-pin-label {
    font-size: 15px;
    font-weight: 700;
    fill: #064e52;
    paint-order: stroke;
    stroke: #f8fafc;
    stroke-width: 4.5px;
    stroke-linejoin: round;
  }
  .dark .de-pin-label {
    fill: #eafdff;
    stroke: #030712;
    stroke-width: 4.5px;
  }
</style>
