---
import type { Locale } from '../../i18n/config';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import GlassCard from '../ui/GlassCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const ui = {
  de: { eyebrow: 'Standorte', title: 'Unsere Standorte', route: 'Route planen' },
  en: { eyebrow: 'Locations', title: 'Our locations', route: 'Get directions' },
}[locale];

const locations = [
  {
    name: 'Bad Kreuznach',
    badge: { de: 'Hauptsitz', en: 'Headquarters' },
    lines: ['Astoria Systems GmbH', 'Bosenheimer Straße 219', '55543 Bad Kreuznach'],
    note: { de: 'Haupt- & Postanschrift', en: 'Main & postal address' },
    lat: 49.8407,
    lon: 7.8671,
    labelDir: 'right' as const,
    maps: 'https://www.google.com/maps/search/?api=1&query=Bosenheimer%20Stra%C3%9Fe%20219%2C%2055543%20Bad%20Kreuznach',
  },
  {
    name: 'Kleve',
    badge: { de: 'Standort', en: 'Office' },
    lines: ['c/o mkm International GmbH', 'Boschstraße 16', '47533 Kleve'],
    note: { de: 'Standort', en: 'Office' },
    lat: 51.788,
    lon: 6.138,
    labelDir: 'right' as const,
    maps: 'https://www.google.com/maps/search/?api=1&query=Boschstra%C3%9Fe%2016%2C%2047533%20Kleve',
  },
];

// ---- Projektion (lon/lat -> SVG) ----
const W = 600;
const H = 780;
const lonMin = 5.5, lonMax = 15.2, latMin = 47.2, latMax = 55.2;
const px = (lon: number) => ((lon - lonMin) / (lonMax - lonMin)) * W;
const py = (lat: number) => ((latMax - lat) / (latMax - latMin)) * H;

// Vereinfachter Deutschland-Umriss (lon, lat), im Uhrzeigersinn
const border: [number, number][] = [
  [8.4, 54.9], [8.9, 54.9], [9.4, 54.8], [9.9, 54.5], [10.0, 54.4], [10.8, 54.0],
  [11.0, 54.4], [11.5, 54.1], [12.5, 54.5], [13.4, 54.1], [14.2, 53.9], [14.4, 53.3],
  [14.1, 52.9], [14.6, 52.6], [14.7, 52.1], [15.0, 51.3], [14.9, 51.0], [14.6, 50.9],
  [14.3, 51.0], [13.5, 50.7], [12.9, 50.4], [12.3, 50.2], [12.5, 49.9], [13.2, 49.4],
  [13.8, 48.9], [13.4, 48.6], [12.9, 48.3], [13.0, 47.8], [12.2, 47.7], [11.4, 47.5],
  [10.9, 47.5], [10.4, 47.5], [10.2, 47.3], [9.6, 47.5], [8.9, 47.7], [8.4, 47.7],
  [7.9, 47.6], [7.6, 48.1], [7.6, 48.7], [8.1, 49.0], [7.4, 49.1], [6.7, 49.2],
  [6.4, 49.5], [6.1, 50.0], [6.0, 50.5], [6.1, 51.1], [5.9, 51.5], [6.2, 51.9],
  [6.7, 52.1], [7.0, 52.4], [6.7, 52.6], [7.0, 53.0], [7.2, 53.3], [8.0, 53.6],
  [8.2, 53.5], [8.5, 53.6], [8.3, 53.9], [8.9, 54.0], [8.6, 54.4],
];
const outlinePath =
  'M ' + border.map(([lo, la]) => `${px(lo).toFixed(1)} ${py(la).toFixed(1)}`).join(' L ') + ' Z';

const pins = locations.map((l) => ({ name: l.name, x: px(l.lon), y: py(l.lat), dir: l.labelDir }));
---

<Section variant="alt" class="overflow-hidden">
  <Container>
    <div class="max-w-3xl mb-12" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">{ui.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-bold">{ui.title}</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
      <!-- Selbstgezeichnete Deutschlandkarte -->
      <div class="order-2 lg:order-1 flex justify-center" data-reveal>
        <svg viewBox="0 0 600 780" class="loc-map w-full h-auto max-h-[460px]" role="img" aria-label="Karte mit Standorten in Deutschland">
          <defs>
            <linearGradient id="locFill" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#00e5ff" stop-opacity="0.10" />
              <stop offset="100%" stop-color="#2e9aa0" stop-opacity="0.05" />
            </linearGradient>
            <filter id="locGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="4" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <pattern id="locDots" width="16" height="16" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1" fill="#00e5ff" fill-opacity="0.18" />
            </pattern>
            <clipPath id="locClip"><path d={outlinePath} /></clipPath>
            <radialGradient id="pin3d" cx="35%" cy="28%" r="80%">
              <stop offset="0%" stop-color="#9af4ff" />
              <stop offset="42%" stop-color="#00e5ff" />
              <stop offset="100%" stop-color="#0b6f7a" />
            </radialGradient>
            <filter id="pinShadow" x="-60%" y="-60%" width="220%" height="220%">
              <feGaussianBlur stdDeviation="1.6" />
            </filter>
          </defs>

          <!-- Fläche + Textur -->
          <path d={outlinePath} fill="url(#locFill)" />
          <rect x="0" y="0" width="600" height="780" fill="url(#locDots)" clip-path="url(#locClip)" />
          <!-- Umriss -->
          <path d={outlinePath} fill="none" stroke="#00e5ff" stroke-opacity="0.55" stroke-width="1.6" stroke-linejoin="round" filter="url(#locGlow)" />

          <!-- 3D-Pins -->
          {pins.map((p) => (
            <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
              <ellipse cx="0" cy="2" rx="7.5" ry="2.6" fill="#000" opacity="0.35" filter="url(#pinShadow)" />
              <path d="M0 0 C -5 -9 -11 -13 -11 -19 A 11 11 0 1 1 11 -19 C 11 -13 5 -9 0 0 Z" fill="url(#pin3d)" stroke="#0a6b75" stroke-width="0.6" />
              <circle cx="0" cy="-19" r="4.6" fill="#06141b" />
              <circle cx="-3.2" cy="-23" r="1.7" fill="#ffffff" opacity="0.7" />
              <text x="15" y="-15" class="loc-pin-label" fill="currentColor">{p.name}</text>
            </g>
          ))}
        </svg>
      </div>

      <!-- Adress-Karten -->
      <div class="order-1 lg:order-2 space-y-6" data-reveal data-reveal-delay="2">
        {locations.map((loc) => (
          <GlassCard class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-white bg-gradient-to-br from-[#0e7490] to-[#2dd4bf]">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </span>
              <div>
                <h3 class="text-lg font-bold leading-tight">{loc.name}</h3>
                <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent-dark)] dark:text-[var(--color-accent)]">{loc.badge[locale]}</span>
              </div>
            </div>
            <address class="not-italic text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
              {loc.lines.map((line) => (<span class="block">{line}</span>))}
            </address>
            <p class="text-xs text-[var(--color-text-tertiary)] dark:text-[var(--color-dark-text-tertiary)] mt-2">{loc.note[locale]}</p>
            <a href={loc.maps} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-4 text-sm font-medium text-[var(--color-accent-dark)] dark:text-[var(--color-accent)] hover:underline">
              {ui.route}
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-8.25 8.25M16.5 18.75h-9a1.5 1.5 0 01-1.5-1.5v-9" /></svg>
            </a>
          </GlassCard>
        ))}
      </div>
    </div>
  </Container>
</Section>

<style>
  .loc-map { color: var(--color-text-primary); }
  :global(.dark) .loc-map { color: var(--color-dark-text-primary); }
  .loc-pin-label { font-size: 16px; font-weight: 600; }
</style>
