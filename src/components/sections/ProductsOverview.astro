---
import type { Locale } from '../../i18n/config';
import { routeMap } from '../../i18n/config';
import { t } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const routes = routeMap[locale];

const products = [
  {
    key: 'communication' as const,
    route: routes['products.communication'],
    icon: `<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>`,
  },
  {
    key: 'security' as const,
    route: routes['products.security'],
    icon: `<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  },
  {
    key: 'infrastructure' as const,
    route: routes['products.infrastructure'],
    icon: `<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7" /></svg>`,
  },
  {
    key: 'development' as const,
    route: routes['products.development'],
    icon: `<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>`,
  },
];
---

<Section id="products-overview" class="!py-16 lg:!py-24">
  <Container>
    <div class="text-center mb-12" data-reveal>
      <span class="inline-block text-sm font-medium text-[var(--color-accent)] uppercase tracking-widest mb-4">
        {t(locale, 'productsOverview.badge')}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4" data-text-reveal>
        {t(locale, 'productsOverview.title')}
      </h2>
      <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] max-w-2xl mx-auto">
        {t(locale, 'productsOverview.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6" data-reveal>
      {products.map((product) => (
        <a
          href={product.route}
          class="group relative block rounded-2xl border border-[var(--color-border)]/50 dark:border-[var(--color-dark-border)]/50 bg-[var(--color-surface-primary)] dark:bg-[var(--color-dark-surface)]"
        >
          <div class="p-5 md:p-6 text-center">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl text-white mb-4 bg-gradient-to-br from-[#0e7490] to-[#2dd4bf]">
              <Fragment set:html={product.icon} />
            </div>
            <h3 class="text-sm md:text-base lg:text-lg font-semibold mb-1 text-[var(--color-accent-dark)] dark:text-[var(--color-accent)]">
              {t(locale, `services.${product.key}.title`)}
            </h3>
            <p class="text-xs md:text-sm text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] line-clamp-2 hidden md:block">
              {t(locale, `services.${product.key}.description`)}
            </p>
            <span class="inline-flex items-center gap-1 text-xs md:text-sm font-medium mt-2 text-[var(--color-accent-dark)] dark:text-[var(--color-accent)] transition-colors">
              {locale === 'de' ? 'Mehr erfahren' : 'Learn more'}
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </Container>
</Section>
