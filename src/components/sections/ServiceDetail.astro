                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style={`background: linear-gradient(135deg, rgba(${colors.rgb}, 0.05), transparent);`}></div>
                  <div class={`icon-lowpoly relative flex-shrink-0 h-10 w-10 rounded-xl bg-gradient-to-br ${colors.gradient} flex items-center justify-center shadow-md transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg`} style={`box-shadow: 0 4px 12px rgba(${colors.rgb}, 0.2);`}>
                    <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <Fragment set:html={filledIcons[getPortfolioIcon(item)]} />
                    </svg>
                  </div>
                  <span class="relative text-sm font-medium">{item}</span>
                </div>
              </div>
            ))}
          </div>
          <!-- Portfolio CTA -->
          <div class="mt-10" data-reveal>
            <div class="sd-cta-card relative rounded-2xl overflow-hidden" style={`--card-rgb: ${colors.rgb}; --card-rgb-end: ${colors.rgbEnd};`}>
              <div class="sd-animated-border absolute inset-0 rounded-2xl"></div>
              <div class="relative glass rounded-2xl p-8 m-[2px] text-center">
                <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] italic mb-6 text-lg">
                  {portfolioNote}
                </p>
                <a
                  href={routes.contact}
                  class={`sd-cta-btn inline-flex items-center gap-2 px-8 py-3.5 rounded-xl font-semibold text-white transition-all duration-400 hover:scale-105`}
                  style={`background: linear-gradient(135deg, rgb(${colors.rgb}), rgb(${colors.rgbEnd})); box-shadow: 0 8px 32px rgba(${colors.rgb}, 0.3);`}
                >
                  {t(locale, 'cta.button')}
                  <svg class="h-4 w-4 sd-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- Industry Solutions (only for infrastructure) -->
  {industrySolutions && (
    <section class="py-20 lg:py-28 relative overflow-hidden">
      <div class="absolute inset-0 animated-bg-grid opacity-30"></div>
      <Container class="relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-14" data-reveal>
          <div class="inline-flex items-center gap-3 mb-4">
            <span class={`h-px w-12 bg-gradient-to-r ${colors.gradient} sd-line-grow`}></span>
            <span class={`text-sm font-semibold uppercase tracking-widest ${colors.textLight}`}>
              {locale === 'de' ? 'Branchen' : 'Industries'}
            </span>
            <span class={`h-px w-12 bg-gradient-to-r ${colors.gradient} sd-line-grow`}></span>
          </div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold">{industrySolutions.title}</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {industrySolutions.categories.map((category, catIndex) => (
            <div class="sd-card-3d group" data-reveal data-reveal-delay={String(Math.min(catIndex + 1, 5))}>
              <div class="sd-card-inner relative h-full" style={`--card-rgb: ${colors.rgb}; --card-rgb-end: ${colors.rgbEnd};`}>
                <div class="sd-card-glow absolute -inset-[1px] rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                <div class="relative glass rounded-2xl p-6 h-full overflow-hidden transition-all duration-500 group-hover:shadow-2xl border border-white/10 dark:border-white/5">
                  <div class="sd-shimmer absolute inset-0 opacity-0 group-hover:opacity-100"></div>
                  <div class="relative mb-4">
                    <div class={`icon-lowpoly inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${colors.gradientVia} text-white shadow-md transition-all duration-500 group-hover:scale-110`} style={`box-shadow: 0 6px 16px rgba(${colors.rgb}, 0.2);`}>
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <Fragment set:html={iconSvgs[category.icon] || iconSvgs.industry} />
                      </svg>
                    </div>
                  </div>
                  <h3 class="relative text-lg font-bold mb-3">{category.name}</h3>
                  <div class="relative flex flex-wrap gap-2">
                    {category.items.map((item) => (
                      <span class={`sd-tag inline-block text-xs px-3 py-1.5 rounded-lg glass border ${colors.border} font-medium transition-all duration-300 hover:scale-105 cursor-default`} style={`--tag-rgb: ${colors.rgb};`}>
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- Benefits / Why choose us -->
  <section class="py-20 lg:py-28">
    <Container>
      <div class="sd-why-block relative overflow-hidden rounded-3xl" data-reveal style={`--card-rgb: ${colors.rgb}; --card-rgb-end: ${colors.rgbEnd};`}>
        <!-- Image background with filters + lowpoly -->
        <div class="absolute inset-0 z-0">
          <img
            src={whyImages[serviceKey]}
            alt=""
            class="w-full h-full object-cover grayscale"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-[#0e7490]/50 mix-blend-color"></div>
          <canvas class="lowpoly-overlay-canvas absolute inset-0 w-full h-full mix-blend-overlay"></canvas>
        </div>
        <!-- Glass overlay for readability -->
        <div class="absolute inset-0 z-[1] bg-white/80 dark:bg-[#0a0e1a]/80 backdrop-blur-md"></div>
        <!-- Lowpoly pattern overlay -->
        <div class="sd-card-lowpoly absolute inset-0 z-[1] pointer-events-none"></div>
        <!-- Content -->
        <div class="relative z-[2] p-8 md:p-12 lg:p-16">
          <div class="max-w-2xl">
            <span class={`inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest mb-4 ${colors.textLight}`}>
              <span class={`h-1 w-8 rounded-full bg-gradient-to-r ${colors.gradient}`}></span>
              {locale === 'de' ? 'Ihre Vorteile' : 'Your Benefits'}
            </span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-10">
              {locale === 'de' ? 'Warum Astoria Systems?' : 'Why Astoria Systems?'}
            </h2>
            <div class="space-y-3 mb-10">
              {benefits.map((benefit, idx) => (
                <div class="sd-benefit-row group animate-fade-in-up" style={`animation-delay: ${0.2 + idx * 0.15}s; --row-rgb: ${colors.rgb};`}>
                  <div class="relative glass rounded-xl p-4 flex items-center gap-4 border border-white/20 dark:border-white/10 transition-all duration-500 group-hover:shadow-xl overflow-hidden">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style={`background: linear-gradient(135deg, rgba(${colors.rgb}, 0.05), transparent);`}></div>
                    <div class="absolute left-0 top-0 bottom-0 w-1 rounded-r-full transition-all duration-500" style={`background: linear-gradient(to bottom, rgb(${colors.rgb}), rgb(${colors.rgbEnd}));`}></div>
                    <div class={`icon-lowpoly relative flex-shrink-0 h-9 w-9 rounded-lg bg-gradient-to-br ${colors.gradient} flex items-center justify-center shadow-md transition-all duration-500 group-hover:scale-110`} style={`box-shadow: 0 3px 12px rgba(${colors.rgb}, 0.25);`}>
                      <span class="text-white text-sm font-bold relative z-[1]">{idx + 1}</span>
                    </div>
                    <span class="relative text-base font-semibold">{benefit}</span>
                  </div>
                </div>
              ))}
            </div>
            <a
              href={routes.contact}
              class="sd-cta-btn inline-flex items-center gap-3 px-10 py-4 rounded-xl font-bold text-white text-lg transition-all duration-400 hover:scale-105"
              style={`background: linear-gradient(135deg, rgb(${colors.rgb}), rgb(${colors.rgbEnd})); box-shadow: 0 8px 40px rgba(${colors.rgb}, 0.35);`}
            >
              {t(locale, 'cta.button')}
              <svg class="h-5 w-5 sd-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <CTA locale={locale} />
</BaseLayout>

<style is:global>
  /* Desktop: fade image right edge into content */
  @media (min-width: 768px) {
    .sd-intro-img {
      -webkit-mask-image: linear-gradient(to right, black 40%, transparent 100%);
      mask-image: linear-gradient(to right, black 40%, transparent 100%);
    }
  }

  /* Intro block min height */
  .sd-intro-block {
    min-height: 320px;
  }
  @media (min-width: 768px) {
    .sd-intro-block {
      min-height: 360px;
    }
  }
  @media (min-width: 1024px) {
    .sd-intro-block {
      min-height: 400px;
    }
  }

  /* Gradient line across top of hero */
  .sd-gradient-line {
    background: linear-gradient(90deg, transparent, var(--line-from), var(--line-to), transparent);
    background-size: 200% 100%;
    animation: sdGradientLineMove 4s ease-in-out infinite;
  }
  @keyframes sdGradientLineMove {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  /* Feature pills */
  .sd-pill {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sd-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(var(--pill-color), 0.12);
    border-color: rgba(var(--pill-color), 0.35) !important;
  }

  /* Animated gradient border for intro/portfolio CTA */
  .sd-animated-border {
    background: conic-gradient(
      from 0deg,
      rgba(var(--card-rgb), 0.35),
      rgba(var(--card-rgb-end), 0.35),
      rgba(var(--card-rgb), 0.08),
      rgba(var(--card-rgb-end), 0.08),
      rgba(var(--card-rgb), 0.35)
    );
    animation: sdBorderSpin 6s linear infinite;
  }
  @keyframes sdBorderSpin {
    0% { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }

  /* Lowpoly pattern on cards */
  .sd-card-lowpoly {
    opacity: 0.04;
    background:
      linear-gradient(120deg, rgba(var(--card-rgb), 1) 0%, rgba(var(--card-rgb), 1) 20%, transparent 20.3%),
      linear-gradient(240deg, rgba(var(--card-rgb), 1) 0%, rgba(var(--card-rgb), 1) 15%, transparent 15.3%),
      linear-gradient(60deg, rgba(var(--card-rgb), 1) 0%, rgba(var(--card-rgb), 1) 30%, transparent 30.3%),
      linear-gradient(300deg, rgba(var(--card-rgb), 1) 0%, rgba(var(--card-rgb), 1) 12%, transparent 12.3%),
      linear-gradient(180deg, rgba(var(--card-rgb), 1) 0%, rgba(var(--card-rgb), 1) 18%, transparent 18.3%);
  }
  .dark .sd-card-lowpoly {
    opacity: 0.06;
  }
  .sd-card-3d:hover .sd-card-lowpoly {
    opacity: 0.08;
    transition: opacity 0.5s ease;
  }

  /* Gradient text */
  .sd-gradient-text {
    background: linear-gradient(135deg, var(--gt-from), var(--gt-to));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Decorative line grow */
  .sd-line-grow {
    animation: sdLineGrow 2s ease-out forwards;
    transform-origin: center;
  }
  @keyframes sdLineGrow {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* Card perspective container */
  .sd-card-3d { perspective: 800px; }

  /* Card glow border on hover */
  .sd-card-glow {
    background: linear-gradient(135deg,
      rgba(var(--card-rgb), 0.25),
      rgba(var(--card-rgb-end), 0.12),
      rgba(var(--card-rgb), 0.25)
    );
    filter: blur(4px);
  }

  /* Subtle shimmer sweep on card hover */
  .sd-shimmer {
    background: linear-gradient(105deg,
      transparent 35%, rgba(255,255,255,0.05) 48%,
      rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.05) 52%,
      transparent 65%);
    background-size: 200% 100%;
    animation: sdShimmerSweep 2.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes sdShimmerSweep {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Bottom accent line on card hover */
  .sd-bottom-line {
    transform: scaleX(0);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sd-card-3d:hover .sd-bottom-line { transform: scaleX(1); }

  /* Portfolio item lift */
  .sd-portfolio-item { transition: transform 0.3s ease; }
  .sd-portfolio-item:hover { transform: translateY(-2px); }

  /* Industry tag hover shimmer */
  .sd-tag { position: relative; overflow: hidden; }
  .sd-tag::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(var(--tag-rgb), 0.06), transparent);
    transition: left 0.5s ease;
  }
  .sd-tag:hover::before { left: 100%; }
  .sd-tag:hover {
    border-color: rgba(var(--tag-rgb), 0.35);
    box-shadow: 0 2px 8px rgba(var(--tag-rgb), 0.08);
  }

  /* CTA button */
  .sd-cta-btn { position: relative; overflow: hidden; }
  .sd-cta-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transition: left 0.5s ease;
  }
  .sd-cta-btn:hover::before { left: 100%; }
  .sd-arrow { transition: transform 0.3s ease; }
  .sd-cta-btn:hover .sd-arrow { transform: translateX(4px); }

  /* Benefit row slide */
  .sd-benefit-row { transition: transform 0.3s ease; }
  .sd-benefit-row:hover { transform: translateX(6px); }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sd-gradient-line, .sd-animated-border, .sd-shimmer,
    .sd-bottom-line, .sd-line-grow, .sd-cta-btn::before,
    .sd-tag::before {
      animation: none !important;
      transition: none !important;
    }
    .sd-benefit-row:hover, .sd-portfolio-item:hover, .sd-pill:hover { transform: none; }
  }
</style>
