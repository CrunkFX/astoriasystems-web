const serviceImages: Record<string, string> = {
  communication: '/images/services/communication.jpg',
  security: '/images/services/security.jpg',
  infrastructure: '/images/services/infrastructure.jpg',
  development: '/images/services/development.jpg',
};

const whyImages: Record<string, string> = {
  communication: '/images/services/communication-why.jpg',
  security: '/images/services/security-why.jpg',
  infrastructure: '/images/services/infrastructure-why.jpg',
  development: '/images/services/development-why.jpg',
};

interface Props {
  locale: Locale;
  serviceKey: 'communication' | 'security' | 'infrastructure' | 'development';
}

const { locale, serviceKey } = Astro.props;
const routes = routeMap[locale];

const serviceTitle = t(locale, `services.${serviceKey}.title`);
const serviceDescription = t(locale, `services.${serviceKey}.description`);
const pageDescription = t(locale, `services.${serviceKey}.pageDescription`);
const intro = t(locale, `services.${serviceKey}.intro`);
const features = tArray(locale, `services.${serviceKey}.features`);
const benefits = tArray(locale, `services.${serviceKey}.benefits`);
const detailSections = tRaw(locale, `services.${serviceKey}.detailSections`) as { title: string; description: string; icon: string }[];
const portfolio = tArray(locale, `services.${serviceKey}.portfolio`);
const portfolioNote = t(locale, `services.${serviceKey}.portfolioNote`);
const industrySolutions = tRaw(locale, `services.${serviceKey}.industrySolutions`) as { title: string; categories: { name: string; icon: string; items: string[] }[] } | undefined;

