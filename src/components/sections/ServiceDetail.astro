// Map portfolio items to icons by keyword matching
const portfolioIconMap: Record<string, string[]> = {
  phone: ['DSL', 'VoIP', 'Telefon', 'Phone', 'Telekom', 'Telecommun'],
  chat: ['Chat', 'Forum', 'Messaging', 'Firmeninter', 'Internal Com', 'Kommunikationsplattform', 'Communication Platform', 'Projektchat', 'Project Chat'],
  email: ['E-Mail', 'Email', 'Mail', 'Massenmail', 'Mass Mail'],
  video: ['Video', 'Webinar', 'Meeting'],
  crm: ['CRM', 'Kunden', 'Customer', 'Vertrieb', 'Sales', 'Angebot', 'Quotation', 'Rechnung', 'Invoice', 'Shop', 'Ticket'],
  automation: ['Automat', 'Marketing', 'Planungs', 'Planning', 'Aufgaben', 'Task', 'Projekt', 'Project', 'Persona', 'Staff', 'Schicht', 'Shift'],
  training: ['Lern', 'Learn', 'Wiki', 'Wissen', 'Knowledge', 'Schulung', 'Training', 'Umfrage', 'Survey', 'Handbuch', 'Manual'],
  encryption: ['Verschlüssel', 'Encrypt', 'Sicher', 'Secure', 'Haftung', 'Liability', 'DSGVO', 'GDPR', 'Passwort', 'Password'],
  mfa: ['MFA', 'Mehrfaktor', 'Multi-Factor', 'Authentif'],
  server: ['Server', 'Cloud', 'Hosting'],
  api: ['API', 'Schnittstelle', 'Interface', 'WebHook', 'Webhook', 'Verknüpfung', 'Integration'],
  mobile: ['App', 'Mobile', 'iOS', 'Android'],
  sensor: ['Sensor', 'Kamera', 'Camera', 'LIDAR', 'Bewegung', 'Motion'],
  database: ['Datenbank', 'Database'],
  iot: ['IoT', 'Fertigung', 'Production', 'Werkstatt', 'Workshop', 'Barcode', 'Lager', 'Warehouse', 'Dropship'],
  accounting: ['Buchhaltung', 'Account', 'DATEV', 'Kasse', 'POS', 'Bezahl', 'Payment', 'Steuer', 'Tax'],
  hr: ['Mitarbeiter', 'HR', 'Employee', 'Urlaub', 'Leave', 'Absence', 'Vertrag', 'Contract'],
  industry: ['Webseite', 'Website', 'Termin', 'Appointment', 'Booking', 'Kalender', 'Calendar', 'Veranstaltung', 'Event', 'Social', 'Signatur', 'Digital Sign', 'Qualität', 'Quality'],
};

// Track used icons to avoid duplicates within same portfolio
const usedIcons = new Set<string>();
const allIconKeys = Object.keys(filledIcons);
let fallbackIdx = 0;

function getPortfolioIcon(item: string): string {
  const lower = item.toLowerCase();
  for (const [icon, keywords] of Object.entries(portfolioIconMap)) {
    if (keywords.some(kw => lower.includes(kw.toLowerCase()))) {
      usedIcons.add(icon);
      return icon;
    }
  }
  // Fallback: cycle through all available icons (skip already-used ones if possible)
  while (fallbackIdx < allIconKeys.length) {
    const key = allIconKeys[fallbackIdx++];
    if (!usedIcons.has(key)) {
      usedIcons.add(key);
      return key;
    }
  }
  return 'custom';
}

const breadcrumbItems = [
  { label: t(locale, 'nav.products'), href: routes.products },
  { label: serviceTitle, href: routes[`products.${serviceKey}`] },
];

const breadcrumbsJsonLd = [
  { name: 'Home', url: routes.home },
  { name: t(locale, 'nav.products'), url: routes.products },
  { name: serviceTitle, url: routes[`products.${serviceKey}`] },
];
---

<BaseLayout
  title={`${serviceTitle} | Astoria Systems`}
  description={pageDescription}
  locale={locale}
  jsonLdType="service"
  breadcrumbs={breadcrumbsJsonLd}
>
  <!-- Hero text (no image background) -->
  <section class="relative pt-24 lg:pt-28 pb-6 lg:pb-8 overflow-hidden">
    <Container class="relative z-10">
      <Breadcrumbs locale={locale} items={breadcrumbItems} />
      <div class="max-w-4xl">
        <div class="animate-fade-in-up">
          <span class={`sd-badge inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] mb-6 px-4 py-2 rounded-full`} style={`background: rgba(${colors.rgb}, 0.12); color: rgb(${colors.rgb}); border: 1px solid rgba(${colors.rgb}, 0.2);`}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <Fragment set:html={iconSvgs[serviceKey === 'communication' ? 'chat' : serviceKey === 'security' ? 'encryption' : serviceKey === 'infrastructure' ? 'server' : 'api']} />
            </svg>
            {t(locale, 'nav.products')}
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold mb-6 animate-fade-in-up animate-delay-1" data-text-reveal>{serviceTitle}</h1>
        <p class="text-xl lg:text-2xl text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] max-w-2xl leading-relaxed mb-4 animate-fade-in-up animate-delay-2">
          {serviceDescription}
        </p>
      </div>
    </Container>
  </section>

  <LowpolyOverlay />

  <!-- Intro section with image -->
  <section class="py-6 lg:py-12 relative overflow-hidden">
    <Container class="relative z-10">
      <div class="sd-intro-block relative rounded-2xl overflow-hidden backdrop-blur-md bg-[var(--color-surface-primary)]/30 dark:bg-[var(--color-dark-surface)]/30 border border-white/10 dark:border-white/5 shadow-lg" data-reveal>
        <!-- Image (full width on mobile, left side on desktop) -->
        <div class="sd-intro-img relative aspect-[4/3] md:aspect-auto md:absolute md:inset-0 md:w-[55%]">
          <img
            src={serviceImages[serviceKey]}
            alt={serviceTitle}
            class="w-full h-full object-cover grayscale"
            loading="eager"
          />
          <div class="absolute inset-0 bg-[#0e7490]/50 mix-blend-color"></div>
          <canvas class="lowpoly-overlay-canvas absolute inset-0 w-full h-full mix-blend-overlay"></canvas>
          <!-- Gradient for text readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent md:hidden"></div>
          <!-- Benefit chips overlaid on image -->
          <!-- Mobile: chips on image -->
          <div class="absolute bottom-0 left-0 right-0 z-10 p-5 md:hidden">
            <div class="flex flex-wrap gap-2">
              {benefits.map((benefit) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium text-white/90 bg-white/10 backdrop-blur-sm border border-white/10">
                  <svg class="h-3 w-3 text-[#00e5ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  {benefit}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Tablet/Desktop content -->
        <div class="hidden md:block relative z-10 md:ml-auto md:w-[50%] md:p-8 lg:p-12 xl:p-16">
            <p class="text-base lg:text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed mb-6">
              {intro}
            </p>
            <div class="flex flex-wrap gap-2">
              {benefits.map((benefit) => (
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium glass border border-white/10 dark:border-white/5">
                  <span class="flex-shrink-0 h-5 w-5 rounded-md bg-gradient-to-br from-[#0e7490] to-[#2dd4bf] flex items-center justify-center">
                    <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                  </span>
                  {benefit}
                </span>
              ))}
            </div>
          </div>
      </div>
    </Container>
  </section>

  <!-- Detail sections grid -->
  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 animated-bg-grid opacity-30"></div>
    <div class="absolute inset-0 animated-bg-dots opacity-20"></div>
    <Container class="relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-3 mb-4">
          <span class={`h-px w-12 bg-gradient-to-r ${colors.gradient} sd-line-grow`}></span>
          <span class={`text-sm font-semibold uppercase tracking-widest ${colors.textLight}`}>
            {locale === 'de' ? 'Leistungen' : 'Services'}
          </span>
          <span class={`h-px w-12 bg-gradient-to-r ${colors.gradient} sd-line-grow`}></span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
          <span class="sd-gradient-text" style={`--gt-from: rgb(${colors.rgb}); --gt-to: rgb(${colors.rgbEnd});`}>{detailSections.length}</span>
          {' '}{locale === 'de' ? 'Leistungen im Überblick' : 'Services at a Glance'}
        </h2>
        <p class="text-lg text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
          {locale === 'de' ? 'Entdecken Sie unsere Lösungen im Detail' : 'Discover our solutions in detail'}
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {detailSections.map((section, index) => (
          <div class="sd-card-3d group" data-reveal data-reveal-delay={String(Math.min(index + 1, 5))}>
            <div class="sd-card-inner relative h-full" style={`--card-rgb: ${colors.rgb}; --card-rgb-end: ${colors.rgbEnd};`}>
              <!-- Animated border glow -->
              <div class="sd-card-glow absolute -inset-[1px] rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
              <div class="relative glass rounded-2xl p-8 h-full overflow-hidden transition-all duration-500 group-hover:shadow-2xl border border-white/10 dark:border-white/5">
                <!-- Shimmer on hover -->
                <div class="sd-shimmer absolute inset-0 opacity-0 group-hover:opacity-100"></div>
                <!-- Corner accent -->
                <div class="absolute top-0 right-0 w-24 h-24 opacity-[0.03] dark:opacity-[0.06]" style={`background: radial-gradient(circle at top right, rgb(${colors.rgb}), transparent 70%);`}></div>
                <!-- Lowpoly card overlay -->
                <div class="sd-card-lowpoly absolute inset-0 pointer-events-none"></div>
                <!-- Icon with animated glow -->
                <div class="relative mb-6">
                  <div class="sd-icon-glow absolute inset-0 rounded-2xl blur-xl opacity-0 group-hover:opacity-40 transition-opacity duration-700" style={`background: rgb(${colors.rgb});`}></div>
                  <div class={`icon-lowpoly relative inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br ${colors.gradientVia} text-white shadow-lg transition-all duration-500 group-hover:scale-110 group-hover:rotate-3`} style={`box-shadow: 0 8px 24px rgba(${colors.rgb}, 0.25);`}>
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <Fragment set:html={iconSvgs[section.icon] || iconSvgs.api} />
                    </svg>
                  </div>
                </div>
                <h3 class="text-xl font-bold mb-3 transition-colors duration-300">
                  {section.title}
                </h3>
                <p class="text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] leading-relaxed">
