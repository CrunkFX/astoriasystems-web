              <span class={`text-sm font-semibold uppercase tracking-widest ${colors.textLight}`}>Portfolio</span>
              <span class={`h-px w-12 bg-gradient-to-r ${colors.gradient} sd-line-grow`}></span>
            </div>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold">
              {locale === 'de' ? 'Unser Portfolio' : 'Our Portfolio'}
            </h2>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
