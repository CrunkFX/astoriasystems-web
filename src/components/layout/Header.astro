---
import type { Locale } from '../../i18n/config';
import { getNavItems } from '../../i18n/config';
import { t } from '../../i18n/utils';
import ThemeToggle from '../interactive/ThemeToggle.tsx';
import LanguageSwitcher from '../interactive/LanguageSwitcher.tsx';
import MobileNav from '../interactive/MobileNav.tsx';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const navItems = getNavItems(locale);
const loginLabel = t(locale, 'nav.login');
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="site-header">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between lg:h-20">
      <!-- Logo -->
      <a href={locale === 'de' ? '/' : '/en'} class="flex items-center group" aria-label="Astoria Systems Home">
        <!-- Mobile: icon only -->
        <img src="/logo-icon-light.svg" alt="Astoria Systems" class="h-9 w-auto lg:hidden dark:hidden" />
        <img src="/logo-icon-dark.svg" alt="Astoria Systems" class="h-9 w-auto hidden dark:block lg:dark:hidden" />
        <!-- Desktop: full horizontal logo -->
        <img src="/logo-light.svg" alt="Astoria Systems" class="h-14 w-auto hidden lg:block dark:lg:hidden" />
        <img src="/logo-dark.svg" alt="Astoria Systems" class="h-14 w-auto hidden lg:dark:block" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && item.href !== '/en' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
                isActive
                  ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/5'
                  : 'text-[var(--color-text-secondary)] dark:text-[var(--color-dark-text-secondary)] hover:text-[var(--color-text-primary)] dark:hover:text-[var(--color-dark-text-primary)] hover:bg-black/5 dark:hover:bg-white/5',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right side: actions -->
      <div class="flex items-center gap-2">
        <ThemeToggle client:load locale={locale} />
        <LanguageSwitcher client:load locale={locale} currentPath={currentPath} />

        <!-- Customer Login button (desktop) -->
        <a
          href="https://odoo.astoria.systems"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden lg:inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg glow-btn"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
          {loginLabel}
        </a>

        <!-- Mobile menu button -->
        <MobileNav client:media="(max-width: 1023px)" locale={locale} navItems={navItems} loginLabel={loginLabel} currentPath={currentPath} />
      </div>
    </div>
  </div>
</header>

<!-- Header background effect (glass on scroll) -->
<script is:inline>
  (function() {
    var header = document.getElementById('site-header');
    if (!header) return;
    var scrolled = false;
    function onScroll() {
      var isScrolled = window.scrollY > 20;
      if (isScrolled !== scrolled) {
        scrolled = isScrolled;
        if (scrolled) {
          header.classList.add('bg-white/80', 'dark:bg-[#030712]/80', 'backdrop-blur-xl', 'border-b', 'border-[var(--color-border)]', 'dark:border-[var(--color-dark-border)]', 'shadow-sm');
        } else {
          header.classList.remove('bg-white/80', 'dark:bg-[#030712]/80', 'backdrop-blur-xl', 'border-b', 'border-[var(--color-border)]', 'dark:border-[var(--color-dark-border)]', 'shadow-sm');
        }
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
